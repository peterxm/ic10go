// 覆盖 M3 领域特性：批量 IO、槽位、通道、栈、设备栈、近似比较与设备引脚。
func main() {
    d0.channel[0][0] = 1
    x := d0.channel[1][3]
    d1.Setting = x

    push(x)
    z := peek()
    y := pop()
    poke(5, y)

    d2.On = isSet(d3)
    d2.Open = isUnset(d3)
    d2.Mode = rmap(d3, hash("Iron"))
    d2.Setting = approx(x, y, 0.1)
    d2.Pressure = approxZero(z, 0.01)

    a := get(d3, 0)
    put(d3, 0, a)
    b := getd(12345, 0)
    putd(12345, 0, b)
    clr(d3)

    total := batch.read(-400115994, "Charge", "Sum")
    avg := batch.read(-400115994, "Ratio", "Average")
    d4.Setting = total
    d5.Setting = avg
    batch.writeName(1220484876, hash("Override"), "Open", 1)
    slot := batch.readSlot(-400115994, 0, "Charge", "Maximum")
    d1.Mode = slot
    d2.Setting = str("Ready!")
}
