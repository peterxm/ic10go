// Round 3: an infinite loop whose last statement calls a device helper, so the
// call is a tail call (IC10: `move ra <loop>; j <body>`, body `j ra`). The
// helper is outlined and reads its ports through drN.
//   d0 LED (Setting/On r/w), d3 ElectronicsPrinter (On r/w), d4 LogicMemory.
const (
	LED = d0
	PRN = d3
	MEM = d4
)

func control(src, dst, lo, hi) {
	v := src.Setting
	if v < lo {
		v = lo
	}
	if v > hi {
		v = hi
	}
	scaled := v * 3
	offset := scaled - 30
	dst.On = abs(offset) > 5
}

func main() {
	for {
		yield()
		control(MEM, LED, 0, 100)
		control(LED, PRN, 0, 100)
	}
}
