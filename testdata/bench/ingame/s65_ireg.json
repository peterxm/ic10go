{
  "program": "s65_ireg.icg",
  "chip": { "name": "A CHIP" },
  "ports": { "d0": "LED", "d1": "Dial", "d4": "Memory" },
  "cases": [
    { "name": "rr2 write+read: 100+7", "set": { "d1.Setting": 0, "d4.Setting": 7 }, "run": 2, "expect": { "d0.Setting": 107 } },
    { "name": "rr4: 100+21", "set": { "d1.Setting": 2, "d4.Setting": 21 }, "run": 2, "expect": { "d0.Setting": 121 } },
    { "name": "rr6 (bank edge): 100+0", "set": { "d1.Setting": 4, "d4.Setting": 0 }, "run": 2, "expect": { "d0.Setting": 100 } },
    { "name": "negative through the pointer", "set": { "d1.Setting": 4, "d4.Setting": -5 }, "run": 2, "expect": { "d0.Setting": 95 } }
  ]
}
