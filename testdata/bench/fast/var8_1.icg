func main() {
    st := 0
    for {
        yield()
        switch st {
    case 0:
        st = 1
    case 1:
        st = 2
    case 2:
        st = 3
    case 3:
        st = 4
    case 4:
        st = 5
    case 5:
        st = 6
    case 6:
        st = 7
    case 7:
        st = 0
    default:
        st = 0
    }
    }
}
