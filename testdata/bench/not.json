{
  "program": "not.icg",
  "chip": { "name": "A CHIP" },
  "ports": { "d0": "LED", "d4": "Memory" },
  "cases": [
    { "name": "0 -> 1", "set": { "d4.Setting": 0 }, "run": 2, "expect": { "d0.Setting": 1 } },
    { "name": "1 -> 0", "set": { "d4.Setting": 1 }, "run": 2, "expect": { "d0.Setting": 0 } },
    { "name": "5 -> 0", "set": { "d4.Setting": 5 }, "run": 2, "expect": { "d0.Setting": 0 } }
  ]
}
