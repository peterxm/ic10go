{
  "name": "icg",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.7.18",
  "publisher": "ic10go",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": ["Programming Languages"],
  "configurationDefaults": {
    "[icg]": {
      "editor.formatOnSave": true
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:icg",
    "onLanguage:ic10",
    "onCommand:icg.compile",
    "onCommand:icg.run",
    "onCommand:icg.decompile",
    "onCommand:icg.minify",
    "onCommand:icg.disasm",
    "onCommand:icg.graph",
    "onCommand:icg.restartServer",
    "onView:icg.bench",
    "onCommand:icg.bench.connect",
    "onCommand:icg.bench.disconnect",
    "onCommand:icg.bench.push",
    "onCommand:icg.bench.refresh",
    "onCommand:icg.bench.watch",
    "onCommand:icg.bench.runScenario",
    "onCommand:icg.bench.openPanel",
    "onCommand:icg.bench.pause",
    "onCommand:icg.bench.loadSave",
    "onCommand:icg.bench.pulseDevice"
  ],
  "contributes": {
    "languages": [
      {
        "id": "icg",
        "aliases": ["IC10 Go", "icg"],
        "extensions": [".icg"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "ic10",
        "aliases": ["IC10", "ic10"],
        "extensions": [".ic", ".ic10"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "icg",
        "scopeName": "source.icg",
        "path": "./syntaxes/icg.tmLanguage.json"
      },
      {
        "language": "ic10",
        "scopeName": "source.ic10",
        "path": "./syntaxes/ic10.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "icg",
        "path": "./snippets/icg.json"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "icg.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%icg.serverPath.desc%"
        },
        "icg.stableIns": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%icg.stableIns.desc%"
        },
        "icg.noCheck": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%icg.noCheck.desc%"
        },
        "icg.autoTable": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%icg.autoTable.desc%"
        },
        "icg.jumpTable": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%icg.jumpTable.desc%"
        },
        "icg.relJump": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%icg.relJump.desc%"
        },
        "icg.fast": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%icg.fast.desc%"
        },
        "icg.unsafe": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%icg.unsafe.desc%"
        },
        "icg.dataLayout": {
          "type": "string",
          "enum": ["top", "middle"],
          "default": "top",
          "markdownDescription": "%icg.dataLayout.desc%"
        },
        "icg.dataAccess": {
          "type": "string",
          "enum": ["get", "stack"],
          "default": "get",
          "markdownDescription": "%icg.dataAccess.desc%"
        },
        "icg.maxLines": {
          "type": "number",
          "default": 128,
          "markdownDescription": "%icg.maxLines.desc%"
        },
        "icg.maxBytes": {
          "type": "number",
          "default": 4096,
          "markdownDescription": "%icg.maxBytes.desc%"
        },
        "icg.maxLine": {
          "type": "number",
          "default": 90,
          "markdownDescription": "%icg.maxLine.desc%"
        },
        "icg.dynamicStack": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%icg.dynamicStack.desc%"
        },
        "icg.userStack": {
          "type": "number",
          "default": 128,
          "markdownDescription": "%icg.userStack.desc%"
        },
        "icg.redundantDeviceWrites": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%icg.redundantDeviceWrites.desc%"
        },
        "icg.mergeRenamedTails": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%icg.mergeRenamedTails.desc%"
        },
        "icg.libDirs": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "markdownDescription": "%icg.libDirs.desc%"
        },
        "icg.trace.server": {
          "type": "string",
          "enum": ["off", "messages"],
          "default": "off",
          "markdownDescription": "%icg.trace.server.desc%"
        },
        "icg.runSteps": {
          "type": "number",
          "default": 0,
          "markdownDescription": "%icg.runSteps.desc%"
        },
        "icg.runTrace": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%icg.runTrace.desc%"
        },
        "icg.runSet": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "markdownDescription": "%icg.runSet.desc%"
        },
        "icg.bench.host": {
          "type": "string",
          "default": "127.0.0.1",
          "markdownDescription": "%icg.bench.host.desc%"
        },
        "icg.bench.port": {
          "type": "number",
          "default": 7800,
          "markdownDescription": "%icg.bench.port.desc%"
        },
        "icg.bench.autoConnect": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%icg.bench.autoConnect.desc%"
        },
        "icg.bench.refreshInterval": {
          "type": "number",
          "default": 0,
          "markdownDescription": "%icg.bench.refreshInterval.desc%"
        },
        "icg.bench.watchOnOpen": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%icg.bench.watchOnOpen.desc%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "icg",
          "title": "%viewContainer.icg%",
          "icon": "resources/ic10.svg"
        }
      ]
    },
    "views": {
      "icg": [
        {
          "id": "icg.bench",
          "name": "%view.bench%",
          "icon": "$(circuit-board)"
        }
      ]
    },
    "commands": [
      {
        "command": "icg.compile",
        "title": "%cmd.compile%",
        "icon": "$(file-code)"
      },
      {
        "command": "icg.run",
        "title": "%cmd.run%"
      },
      {
        "command": "icg.decompile",
        "title": "%cmd.decompile%"
      },
      {
        "command": "icg.minify",
        "title": "%cmd.minify%"
      },
      {
        "command": "icg.disasm",
        "title": "%cmd.disasm%"
      },
      {
        "command": "icg.graph",
        "title": "%cmd.graph%",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "icg.restartServer",
        "title": "%cmd.restartServer%"
      },
      {
        "command": "icg.bench.push",
        "title": "%cmd.bench.push%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "icg.bench.connect",
        "title": "%cmd.bench.connect%",
        "icon": "$(plug)"
      },
      {
        "command": "icg.bench.disconnect",
        "title": "%cmd.bench.disconnect%",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "icg.bench.refresh",
        "title": "%cmd.bench.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "icg.bench.watch",
        "title": "%cmd.bench.watch%",
        "icon": "$(pulse)"
      },
      {
        "command": "icg.bench.runScenario",
        "title": "%cmd.bench.runScenario%",
        "icon": "$(beaker)"
      },
      {
        "command": "icg.bench.openPanel",
        "title": "%cmd.bench.openPanel%",
        "icon": "$(open-preview)"
      },
      {
        "command": "icg.bench.pause",
        "title": "%cmd.bench.pause%",
        "icon": "$(debug-pause)"
      },
      {
        "command": "icg.bench.loadSave",
        "title": "%cmd.bench.loadSave%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "icg.bench.selectChip",
        "title": "%cmd.bench.selectChip%"
      },
      {
        "command": "icg.bench.setDevice",
        "title": "%cmd.bench.setDevice%"
      },
      {
        "command": "icg.bench.pulseDevice",
        "title": "%cmd.bench.pulseDevice%",
        "icon": "$(zap)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "icg.compile",
          "when": "editorLangId == icg",
          "group": "navigation"
        },
        {
          "command": "icg.run",
          "when": "editorLangId == icg",
          "group": "navigation"
        },
        {
          "command": "icg.graph",
          "when": "editorLangId == icg",
          "group": "navigation"
        },
        {
          "command": "icg.decompile",
          "when": "editorLangId == ic10",
          "group": "navigation"
        },
        {
          "command": "icg.minify",
          "when": "editorLangId == ic10",
          "group": "navigation"
        },
        {
          "command": "icg.disasm",
          "when": "editorLangId == ic10",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "icg.bench.push",
          "when": "editorLangId == icg",
          "group": "navigation@1"
        },
        {
          "command": "icg.bench.runScenario",
          "when": "editorLangId == icg",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "icg.bench.push",
          "when": "view == icg.bench",
          "group": "navigation@1"
        },
        {
          "command": "icg.bench.runScenario",
          "when": "view == icg.bench",
          "group": "navigation@2"
        },
        {
          "command": "icg.bench.watch",
          "when": "view == icg.bench",
          "group": "navigation@3"
        },
        {
          "command": "icg.bench.refresh",
          "when": "view == icg.bench",
          "group": "navigation@4"
        },
        {
          "command": "icg.bench.pause",
          "when": "view == icg.bench",
          "group": "navigation@5"
        },
        {
          "command": "icg.bench.loadSave",
          "when": "view == icg.bench",
          "group": "navigation@6"
        },
        {
          "command": "icg.bench.openPanel",
          "when": "view == icg.bench",
          "group": "navigation@7"
        }
      ],
      "commandPalette": [
        {
          "command": "icg.bench.setDevice",
          "when": "false"
        },
        {
          "command": "icg.bench.pulseDevice",
          "when": "false"
        },
        {
          "command": "icg.bench.selectChip",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "icg.bench.pulseDevice",
          "when": "view == icg.bench && viewItem == deviceLogic",
          "group": "inline@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "icg.compile",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorLangId == icg"
      },
      {
        "command": "icg.run",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorLangId == icg"
      },
      {
        "command": "icg.bench.push",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u",
        "when": "editorLangId == icg"
      },
      {
        "command": "icg.bench.runScenario",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "editorLangId == icg"
      }
    ]
  }
}
