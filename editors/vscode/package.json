{
  "name": "icg",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.6.0",
  "publisher": "ic10go",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": ["Programming Languages"],
  "configurationDefaults": {
    "[icg]": {
      "editor.formatOnSave": true
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:icg",
    "onLanguage:ic10",
    "onCommand:icg.compile",
    "onCommand:icg.run",
    "onCommand:icg.decompile",
    "onCommand:icg.minify",
    "onCommand:icg.disasm",
    "onCommand:icg.restartServer"
  ],
  "contributes": {
    "languages": [
      {
        "id": "icg",
        "aliases": ["IC10 Go", "icg"],
        "extensions": [".icg"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "ic10",
        "aliases": ["IC10", "ic10"],
        "extensions": [".ic", ".ic10"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "icg",
        "scopeName": "source.icg",
        "path": "./syntaxes/icg.tmLanguage.json"
      },
      {
        "language": "ic10",
        "scopeName": "source.ic10",
        "path": "./syntaxes/ic10.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "icg",
        "path": "./snippets/icg.json"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "icg.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%icg.serverPath.desc%"
        },
        "icg.stableIns": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%icg.stableIns.desc%"
        },
        "icg.noCheck": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%icg.noCheck.desc%"
        },
        "icg.autoTable": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%icg.autoTable.desc%"
        },
        "icg.jumpTable": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%icg.jumpTable.desc%"
        },
        "icg.relJump": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%icg.relJump.desc%"
        },
        "icg.fast": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%icg.fast.desc%"
        },
        "icg.unsafe": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%icg.unsafe.desc%"
        },
        "icg.dataLayout": {
          "type": "string",
          "enum": ["top", "middle"],
          "default": "top",
          "markdownDescription": "%icg.dataLayout.desc%"
        },
        "icg.dataAccess": {
          "type": "string",
          "enum": ["get", "stack"],
          "default": "get",
          "markdownDescription": "%icg.dataAccess.desc%"
        },
        "icg.runSteps": {
          "type": "number",
          "default": 0,
          "markdownDescription": "%icg.runSteps.desc%"
        },
        "icg.runTrace": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%icg.runTrace.desc%"
        },
        "icg.runSet": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "markdownDescription": "%icg.runSet.desc%"
        }
      }
    },
    "commands": [
      {
        "command": "icg.compile",
        "title": "%cmd.compile%",
        "icon": "$(file-code)"
      },
      {
        "command": "icg.run",
        "title": "%cmd.run%"
      },
      {
        "command": "icg.decompile",
        "title": "%cmd.decompile%"
      },
      {
        "command": "icg.minify",
        "title": "%cmd.minify%"
      },
      {
        "command": "icg.disasm",
        "title": "%cmd.disasm%"
      },
      {
        "command": "icg.restartServer",
        "title": "%cmd.restartServer%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "icg.compile",
          "when": "editorLangId == icg",
          "group": "navigation"
        },
        {
          "command": "icg.run",
          "when": "editorLangId == icg",
          "group": "navigation"
        },
        {
          "command": "icg.decompile",
          "when": "editorLangId == ic10",
          "group": "navigation"
        },
        {
          "command": "icg.minify",
          "when": "editorLangId == ic10",
          "group": "navigation"
        },
        {
          "command": "icg.disasm",
          "when": "editorLangId == ic10",
          "group": "navigation"
        }
      ]
    }
  }
}
