{
  "name": "icg",
  "displayName": "IC10 Go (.icg)",
  "description": "Syntax highlighting, language server, compile preview and VM run for the .icg language compiled by ic10c",
  "version": "0.5.0",
  "publisher": "ic10go",
  "license": "MIT",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:icg",
    "onLanguage:ic10",
    "onCommand:icg.compile",
    "onCommand:icg.run",
    "onCommand:icg.decompile",
    "onCommand:icg.minify",
    "onCommand:icg.disasm",
    "onCommand:icg.restartServer"
  ],
  "contributes": {
    "languages": [
      {
        "id": "icg",
        "aliases": ["IC10 Go", "icg"],
        "extensions": [".icg"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "ic10",
        "aliases": ["IC10", "ic10"],
        "extensions": [".ic", ".ic10"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "icg",
        "scopeName": "source.icg",
        "path": "./syntaxes/icg.tmLanguage.json"
      },
      {
        "language": "ic10",
        "scopeName": "source.ic10",
        "path": "./syntaxes/ic10.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "icg",
        "path": "./snippets/icg.json"
      }
    ],
    "configuration": {
      "title": "IC10 Go",
      "properties": {
        "icg.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `ic10c` executable. Leave empty to use `ic10c` from PATH, or a binary named `ic10c` in the workspace folder."
        },
        "icg.stableIns": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Compile with `--stable-ins` (the stable game branch's `ins` argument order). Leave off for the beta branch."
        },
        "icg.noCheck": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Disable device logic-type checks (`IC10C_NO_CHECK`)."
        }
      }
    },
    "commands": [
      {
        "command": "icg.compile",
        "title": "IC10 Go: Compile to IC10",
        "icon": "$(file-code)"
      },
      {
        "command": "icg.run",
        "title": "IC10 Go: Run in VM"
      },
      {
        "command": "icg.decompile",
        "title": "IC10 Go: Decompile IC10 to .icg"
      },
      {
        "command": "icg.minify",
        "title": "IC10 Go: Minify IC10"
      },
      {
        "command": "icg.disasm",
        "title": "IC10 Go: Annotate IC10 (disasm)"
      },
      {
        "command": "icg.restartServer",
        "title": "IC10 Go: Restart Language Server"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "icg.compile",
          "when": "editorLangId == icg",
          "group": "navigation"
        },
        {
          "command": "icg.run",
          "when": "editorLangId == icg",
          "group": "navigation"
        },
        {
          "command": "icg.decompile",
          "when": "editorLangId == ic10",
          "group": "navigation"
        },
        {
          "command": "icg.minify",
          "when": "editorLangId == ic10",
          "group": "navigation"
        },
        {
          "command": "icg.disasm",
          "when": "editorLangId == ic10",
          "group": "navigation"
        }
      ]
    }
  }
}
