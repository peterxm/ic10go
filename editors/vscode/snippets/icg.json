{
  "Main loop": {
    "prefix": "main",
    "body": [
      "func main() {",
      "    for {",
      "        yield()",
      "        $0",
      "    }",
      "}"
    ],
    "description": "main function with a per-tick loop"
  },
  "Function": {
    "prefix": "func",
    "body": [
      "func ${1:name}(${2:x num}) num {",
      "    $0",
      "    return ${3:x}",
      "}"
    ],
    "description": "function (inlined, no recursion)"
  },
  "Const block": {
    "prefix": "const",
    "body": [
      "const (",
      "    ${1:Name} = ${2:0}",
      ")"
    ],
    "description": "constant block"
  },
  "Data table": {
    "prefix": "data",
    "body": [
      "data ${1:Table} = [",
      "    ${2:0},",
      "]"
    ],
    "description": "persistent-stack data table (run the loader once)"
  },
  "Table switch": {
    "prefix": "switchtable",
    "body": [
      "switch ${1:x} table {",
      "case ${2:0}: ${3:target} = ${4:0}",
      "case ${5:1}: ${3:target} = ${6:0}",
      "}"
    ],
    "description": "switch lowered to a data-segment lookup (dense integer cases)"
  },
  "Device read": {
    "prefix": "read",
    "body": ["${1:d0}.${2:On} = ${3:1}"],
    "description": "write a device logic type"
  },
  "Dynamic logic read": {
    "prefix": "readlt",
    "body": ["read(${1:d0}, ${2:LogicType.Open})"],
    "description": "read with a runtime logic type"
  },
  "Dynamic logic write": {
    "prefix": "writelt",
    "body": ["write(${1:d0}, ${2:LogicType.Open}, ${3:1})"],
    "description": "write with a runtime logic type"
  },
  "Dynamic device read": {
    "prefix": "readdev",
    "body": ["readDev(${1:0}, ${2:LogicType.Open})"],
    "description": "read a register-selected device with a runtime logic type"
  },
  "Dynamic device write": {
    "prefix": "writedev",
    "body": ["writeDev(${1:0}, ${2:LogicType.Open}, ${3:1})"],
    "description": "write a register-selected device with a runtime logic type"
  },
  "Hysteresis control": {
    "prefix": "hyst",
    "body": [
      "const (",
      "    Max${1:Temp} = ${2:296.15}",
      "    Min${1:Temp} = ${3:283.15}",
      ")",
      "",
      "func main() {",
      "    var on = 0",
      "    for {",
      "        yield()",
      "        v := ${4:d1}.${5:Temperature}",
      "        if v < Min${1:Temp} { on = 1 }",
      "        if v > Max${1:Temp} { on = 0 }",
      "        ${6:d0}.On = on",
      "    }",
      "}"
    ],
    "description": "hysteresis on/off control loop"
  },
  "PID control": {
    "prefix": "pid",
    "body": [
      "const (",
      "    Kp       = ${1:2.0}",
      "    Ki       = ${2:0.1}",
      "    Kd       = ${3:0.5}",
      "    Setpoint = ${4:300.0}",
      "    OutMin   = ${5:0.0}",
      "    OutMax   = ${6:100.0}",
      "    IntMin   = -100.0",
      "    IntMax   = 100.0",
      "    Deadband = 0.5",
      ")",
      "",
      "func main() {",
      "    integral := 0.0",
      "    prev := 0.0",
      "    for {",
      "        yield()",
      "        e := Setpoint - ${7:d1}.${8:Temperature}",
      "",
      "        // deadband: ignore small errors",
      "        if e > -Deadband && e < Deadband { e = 0 }",
      "",
      "        // integral + anti-windup",
      "        integral = integral + e",
      "        if integral > IntMax { integral = IntMax }",
      "        if integral < IntMin { integral = IntMin }",
      "",
      "        // output + clamp",
      "        out := Kp*e + Ki*integral + Kd*(e-prev)",
      "        if out > OutMax { out = OutMax }",
      "        if out < OutMin { out = OutMin }",
      "",
      "        ${9:d0}.${10:Setting} = out",
      "        prev = e",
      "    }",
      "}"
    ],
    "description": "software PID control loop (deadband, anti-windup, output clamp)"
  },
  "Hardware PID setup": {
    "prefix": "piddev",
    "body": [
      "// 硬件 PID 控制器（StructureLogicPidController）：先把 IN 螺丝接测量设备、",
      "// VAR 螺丝选跟踪参数；改动参数后需要再次 Reset = 1。",
      "const (",
      "    Setpoint = ${1:293.15}",
      "    Kp       = ${2:2.0}",
      "    Ki       = ${3:0.1}",
      "    Kd       = ${4:0.5}",
      "    OutMin   = ${5:-100.0}",
      "    OutMax   = ${6:100.0}",
      ")",
      "",
      "func main() {",
      "    ${7:d0}.Setpoint = Setpoint",
      "    ${7:d0}.ProportionalGain = Kp",
      "    ${7:d0}.IntegralGain = Ki",
      "    ${7:d0}.DerivativeGain = Kd",
      "    ${7:d0}.Minimum = OutMin",
      "    ${7:d0}.Maximum = OutMax",
      "    ${7:d0}.On = 1",
      "    ${7:d0}.Reset = 1",
      "    for {",
      "        yield()",
      "        ${8:d1}.Setting = ${7:d0}.Setting // PID 输出；${7:d0}.Error 是误差",
      "    }",
      "}"
    ],
    "description": "hardware PID controller (StructureLogicPidController) setup"
  },
  "Batch read": {
    "prefix": "batchread",
    "body": ["batch.read(hash(\"${1:StructureBattery}\"), \"${2:Ratio}\", \"${3:Average}\")"],
    "description": "batch read from devices of one type"
  },
  "Batch write": {
    "prefix": "batchwrite",
    "body": ["batch.write(hash(\"${1:StructureBattery}\"), \"${2:On}\", ${3:1})"],
    "description": "batch write to devices of one type"
  },
  "Slot read": {
    "prefix": "slotread",
    "body": ["${1:d2}.slot[${2:0}].${3:Mature}"],
    "description": "read a machine slot property"
  },
  "Device stack read": {
    "prefix": "stackread",
    "body": ["${1:d0}.stack[${2:0}]"],
    "description": "read a device memory stack entry (get)"
  },
  "Device stack write": {
    "prefix": "stackwrite",
    "body": ["${1:d0}.stack[${2:0}] = ${3:0}"],
    "description": "write a device memory stack entry (put)"
  },
  "Read by ReferenceId": {
    "prefix": "readbyid",
    "body": ["readById(${1:id}, ${2:LogicType.Open})"],
    "description": "read a logic type by device ReferenceId (IC10 ld)"
  },
  "Write by ReferenceId": {
    "prefix": "writebyid",
    "body": ["writeById(${1:id}, ${2:LogicType.Open}, ${3:1})"],
    "description": "write a logic type by device ReferenceId (IC10 sd)"
  },
  "Dynamic slot read": {
    "prefix": "readdevslot",
    "body": ["readDevSlot(${1:0}, ${2:0}, ${3:Occupied})"],
    "description": "read a slot from a register-selected device port (IC10 ls drN)"
  },
  "Sorter filter instruction": {
    "prefix": "sorterfilter",
    "body": ["sorter.filterSortingClass(${1:Equals}, ${2:SortingClass.Ores})"],
    "description": "build a Logic Sorter filter instruction"
  },
  "Printer execute recipe": {
    "prefix": "printerexec",
    "body": ["printer.executeRecipe(${1:50}, hash(\"${2:ItemCableCoil}\"))"],
    "description": "build a Printer ExecuteRecipe instruction"
  },
  "If / else": {
    "prefix": "ifelse",
    "body": [
      "if ${1:cond} {",
      "    $2",
      "} else {",
      "    $3",
      "}"
    ],
    "description": "if / else"
  },
  "For range": {
    "prefix": "forrange",
    "body": [
      "for ${1:i} := range ${2:5} {",
      "    $0",
      "}"
    ],
    "description": "for range over a count or a data table"
  },
  "Switch interval": {
    "prefix": "switchrange",
    "body": [
      "switch ${1:x} {",
      "case ${2:0}..${3:9}: ${4:target} = ${5:0}",
      "default: ${4:target} = ${6:0}",
      "}"
    ],
    "description": "switch with an inclusive interval case"
  },
  "Chip block": {
    "prefix": "chip",
    "body": [
      "chip ${1:display} {",
      "    use ${2:Display} on ${3:db:0}",
      "    func main() {",
      "        for {",
      "            yield()",
      "            $0",
      "        }",
      "    }",
      "}"
    ],
    "description": "multi-chip: a chip block with a bus access point"
  },
  "Bus": {
    "prefix": "bus",
    "body": [
      "bus ${1:Display} {",
      "    ${2:value} num",
      "}"
    ],
    "description": "multi-chip: a named network bus (channel contract)"
  },
  "Import": {
    "prefix": "import",
    "body": ["import \"${1:lib.icg}\""],
    "description": "import another file's const/data/func"
  },
  "Function (multiple return)": {
    "prefix": "func2",
    "body": [
      "func ${1:name}(${2:a num}, ${3:b num}) (num, num) {",
      "    return ${2:a}, ${3:b}",
      "}"
    ],
    "description": "function returning several values (always inlined)"
  },
  "Multiple assignment": {
    "prefix": "multi",
    "body": ["${1:x}, ${2:y} := ${3:pair}()"],
    "description": "destructure a multiple-return call"
  },
  "Data comprehension": {
    "prefix": "datagen",
    "body": ["data ${1:Table} = [ ${2:i * i} for ${3:i} in ${4:0}..${5:255} ]"],
    "description": "generate a data table at compile time"
  },
  "Const from function": {
    "prefix": "constfn",
    "body": ["const ${1:K} = ${2:helper}(${3:3})"],
    "description": "compile-time constant from a pure function"
  },
  "Ternary": {
    "prefix": ["ternary", "?:"],
    "body": ["${1:cond} ? ${2:a} : ${3:b}"],
    "description": "conditional (ternary) expression"
  },
  "String literal": {
    "prefix": "str",
    "body": ["str(\"${1:text}\")"],
    "description": "display string literal, lowered to STR(\"...\")"
  },
  "Concatenated string": {
    "prefix": ["strcat", "concat"],
    "body": ["str(\"${1:Re}\" + \"${2:ady!}\")"],
    "description": "compile-time concatenated display string"
  },
  "Prefab hash": {
    "prefix": "hash",
    "body": ["hash(\"${1:ItemIronOre}\")"],
    "description": "prefab/item hash (links to the community wiki)"
  }
}
