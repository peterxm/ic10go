// 自动燃烧深层矿机：先安全启动（逐步升 Throttle），进入运行后监控转速/节流，
// 若出现"节流 >= 20 且转速 <= 100"的失速征兆则紧急停机并重新初始化。
// d0=指示灯（可删），db=矿机。

func main() {
    for {
        // Init：等待 Stress 降到 10 以下
        for db.Stress > 10 { }

        // Start10：开阀并升到 10 节流，等 Stress 升到 40
        db.Open = 1
        db.Throttle = 10
        for db.Stress < 40 { }

        // Start0：回到 0 节流，等 Stress 降到 30 以下
        for {
            db.Throttle = 0
            s := db.Stress
            d0.Setting = db.ExportCount
            if s <= 30 { break }
        }

        // Startrpm：升到 10 节流，等 Stress 降到 20 以下
        for {
            db.Throttle = 10
            s := db.Stress
            d0.Setting = db.ExportCount
            if s <= 20 { break }
        }

        // Start50：升到 50 节流，等转速达到 350
        for {
            db.Throttle = 50
            r := db.Rpm
            d0.Setting = db.ExportCount
            if r >= 350 { break }
        }

        // StartFull：满负荷
        db.Throttle = 100
        db.CombustionLimiter = 30

        // Operation：监控失速
        for {
            if db.Throttle >= 20 && db.Rpm <= 100 { break }
            d0.Setting = db.ExportCount
        }

        // Emergency：紧急停机并等待 Stress 回落，然后重新 Init
        db.Throttle = 0
        db.CombustionLimiter = 0
        for db.Stress > 10 { }
    }
}
