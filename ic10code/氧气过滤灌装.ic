alias dSelf db
alias dActVent d0

alias rVentPre r0
alias rVentStats r1
alias rFilterStats r2
alias rFilterPre r3

#滞回控制过滤器压力Pa，建立压差实现高速过滤
define PreMax 45000
define PreMin 40000

main:
	yield
	jal ventControl
	jal filterControl
j main

ventControl:
#主动通风保持吸入模式，防止意外改成排气模式
s dActVent Mode 1
l rVentPre dActVent PressureOutput
select rVentStats rVentStats PreMax PreMin
slt rVentStats rVentPre rVentStats
s dActVent On rVentStats
j ra

#控制过滤器出口压力，匹配智能气瓶的最大承压
filterControl:
l rFilterPre dSelf PressureOutput
slt rFilterStats rFilterPre 19000
s dSelf Mode rFilterStats
j ra