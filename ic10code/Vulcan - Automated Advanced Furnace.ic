#____________________________________
# Vulcan - Automated Advanced Furnace
# by RoFLiK
#____________________________________


define furnace HASH("StructureAdvancedFurnace")
define pump HASH("StructureVolumePump")
define CH4O2Pump HASH("CH4O2 Pump")
define CO2Pump HASH("CO2 Pump")
define dial HASH("StructureLogicDial")
define IngotDial HASH("Ingot Dial")
define button HASH("StructureLogicButton")
define buttonC HASH("Confirm")

alias Temp r0
alias Press r1
alias MinT r2
alias MaxT r3
alias MinP r4
alias MaxP r5
alias recipe r6
alias state r14
alias isConfirmed r15

MAIN:
			yield
			move state 0
			s db Setting state
			lbn recipe dial IngotDial Setting 1
			# Control if pressed "Confirm" button
			lbn isConfirmed button buttonC Setting 1
			beq isConfirmed 1 start
			#If not pressed and furnace is not working, wait
			beq state 1 evalRecipe
		j MAIN
		start:
		move state 1
		s db Setting state
		#0:Iron, 1:Copper 2:Gold, 3:Lead, 4:Nickel, 5:Silver, 6:Silicon, 7:Solid Fuel
		#8:Steel, 9:Solder, 10:Invar, 11:Electrum, 12:Constant
		#13:Waspaloy, 14:Stellite, 15:Inconel 16:Hastelloy, 17:Astroloy
		evalRecipe:
		lbn recipe dial IngotDial Setting 1
		beq recipe 0 rBase
		beq recipe 1 rBase
		beq recipe 2 rBase
		beq recipe 3 rBase
		beq recipe 4 rBase
		beq recipe 5 rBase
		beq recipe 6 rBase
		beq recipe 7 rBase
		beq recipe 8 rSteel
		beq recipe 9 rSolder
		beq recipe 10 rInvar
		beq recipe 11 rElectrum
		beq recipe 12 rConstant
		beq recipe 13 rWaspaloy
		beq recipe 14 rStellite
		beq recipe 15 rInconel
		beq recipe 16 rHastelloy
		beq recipe 17 rAstroloy
	j MAIN
	rBase:
	move MinT 950
	move MaxT 100000
	move MinP 1000
	move MaxP 25000
	j control
	rSteel:
	rSolder:
	rInvar:
	rElectrum:
	rConstant:
	rWaspaloy:
	rStellite:
	rInconel:
	rHastelloy:
	rAstroloy:
	j control
	control:
					lb Temp furnace Temperature 1
					lb Press furnace Pressure 1
					blt Temp MinT addfuel
					blt Press MinP addfuel
					bgt Temp MaxT addcoolant
					addfuel:
					sbn pump CH4O2Pump Setting 10
					sb furnace SettingInput 10
					sleep 1
					sbn pump CH4O2Pump Setting 0
					sb furnace SettingInput 0
				j control
				addcoolant:
				sbn pump CO2Pump Setting 10
				sb furnace SettingInput 10
				sleep 1
				sbn pump CO2Pump Setting 0
				sb furnace SettingInput 0
			j control
			exhaust:
			sb furnace SettingOutput 10
			sleep 1
			sb furnace SettingOutput 0
		j control

		#IGNORE BELLOW FOR NOW
		beq r13 1 FINISH
	j control
	FINISH:
	move state 0
j MAIN