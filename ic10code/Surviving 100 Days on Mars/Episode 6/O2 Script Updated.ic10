#Naming Variables
alias O2Filter db
alias largeVent d0
alias sensor d1
alias outputPressure r0
alias turnOn r1
move turnOn 0
alias airTemperature r2
alias tankPressure r3

main:
jal filterOxygen
jal marsGasCapture
yield
j main

#filter O2 out of the room if certain conditions are met
filterOxygen:
l outputPressure O2Filter PressureOutput #checks the pressure on the output pipe
slt turnOn outputPressure 15000 #sets 'turnOn' to '1' if the presure is under 15Mpa
s O2Filter Mode turnOn #turns on the filter until pressure reaches 1Mpa
yield
j ra

#Gather gas from the atmosphere during peak day temperatures
marsGasCapture:
l airTemperature sensor Temperature
sub airTemperature airTemperature 273 #converting to Celcius
sgt r5 airTemperature 6.5
l tankPressure O2Filter PressureInput
slt r6 tankPressure 15000
and turnOn r5 r6
s largeVent On turnOn
yield
j ra