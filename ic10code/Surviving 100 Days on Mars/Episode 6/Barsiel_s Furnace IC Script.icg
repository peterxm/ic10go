// 智能熔炉控制（Episode 6，Barsiel）。
// 启动后等待用户在 IC 宿主（db.Setting）设置一组限值，解析为：
//   min/max 温度、min/max 压力（各 5 位，写在 db.Setting 的小数部分）。
// 随后进入控制循环，调节燃料泵/冷却液泵流量与开关，处理一批完成后复位。

const (
    furnace  = 545937711   // 熔炉
    pump     = -321403609  // 泵组
    ic       = 2037291645  // 本 IC（Hash IC）
    dial     = 554524804   // 旋钮
    analyzer = 435685051   // 气体分析仪
    led      = -815193061  // LED
)

func main() {
    for {
        // ---- start：初始化，等待用户设置 db.Setting ----
        for {
            initFurnace()
            if db.Setting > 0 { break }
        }

        // 解析 db.Setting 的小数部分：4 个 5 位字段
        x := db.Setting * 100000
        mintemp := trunc(x)
        x = x % mintemp
        x = x * 100000
        maxtemp := trunc(x)
        x = x % maxtemp
        x = x * 100000
        minpress := trunc(x)
        x = x % minpress
        x = x * 100000
        maxpress := trunc(x)

        // ---- set：控制循环，直到一批完成 ----
        control(mintemp, maxtemp, minpress, maxpress)

        // ---- end：开炉，等待炉内清空后复位 ----
        batch.writeName(furnace, hash("A Furnace"), "Open", 1)
        for batch.readName(furnace, hash("A Furnace"), "Reagents", "Maximum") > 0 {
            yield()
        }
        batch.writeName(dial, hash("Ingot Dial"), "Setting", 0)
        batch.writeName(furnace, hash("A Furnace"), "SettingOutput", 0)
    }
}

// 初始化熔炉与泵，复位显示。
func initFurnace() {
    fuelPress := batch.readName(analyzer, hash("Fuel PA"), "Pressure", "Maximum")
    batch.writeName(2104106366, hash("Fuel Mixer"), "On", fuelPress < 5000)

    on := batch.readName(furnace, hash("A Furnace"), "On", "Sum")
    batch.writeName(1944485013, hash("SLight"), "On", on)
    batch.writeName(1944485013, hash("SLight"), "Color", 4)
    batch.writeName(led, hash("SLed"), "On", on)
    batch.writeName(led, hash("SLed"), "Mode", 10)
    batch.writeName(led, hash("SLed"), "Setting", str("Ready!"))

    flush := batch.readName(1220484876, hash("Flush"), "Open", "Sum")
    press := batch.readName(furnace, hash("A Furnace"), "Pressure", "Maximum")
    flush = (flush | (press > 40000)) * 100
    batch.writeName(furnace, hash("A Furnace"), "SettingOutput", flush)
    batch.writeName(furnace, hash("A Furnace"), "SettingInput", 0)

    db.Setting = -1
    batch.writeName(pump, hash("CoolantPump"), "Setting", 0)
    batch.writeName(pump, hash("FuelPump"), "Setting", 0)
    batch.writeName(pump, hash("FuelPump"), "On", 0)
    batch.writeName(pump, hash("CoolantPump"), "On", 0)
    batch.writeName(furnace, hash("A Furnace"), "Open", 0)
    yield()
}

// 控制循环：调泵、保护温度压力、检测一批是否完成。
func control(mintemp, maxtemp, minpress, maxpress num) {
    for {
        batch.writeName(2104106366, hash("Fuel Mixer"), "On", 0)
        batch.writeName(1944485013, hash("SLight"), "Color", 2)
        batch.writeName(led, hash("SLed"), "Setting", str("Active"))

        temp := batch.readName(furnace, hash("A Furnace"), "Temperature", "Maximum")
        if temp > 600 {
            batch.writeName(furnace, hash("A Furnace"), "Activate", 1)
            batch.writeName(furnace, hash("A Furnace"), "SettingInput", 100)
        }

        // 燃料泵流量：理想气体方程
        fuelVol := batch.readName(analyzer, hash("Fuel PA"), "Volume", "Sum")
        if temp == 0 { temp = 300 }
        ratio := maxtemp / temp
        flow := fuelVol * minpress * ratio * 500
        fuelT := batch.readName(analyzer, hash("Fuel PA"), "Temperature", "Sum")
        fuelMoles := batch.readName(analyzer, hash("Fuel PA"), "TotalMoles", "Sum")
        batch.writeName(pump, hash("FuelPump"), "Setting", flow/(fuelT*fuelMoles*8314.46))

        // 冷却液泵流量：温度越高，流量越大
        coolT := batch.readName(analyzer, hash("Coolant PA"), "Temperature", "Sum")
        coolVol := batch.readName(analyzer, hash("Coolant PA"), "Volume", "Sum")
        temp = batch.readName(furnace, hash("A Furnace"), "Temperature", "Maximum")
        r := temp / maxtemp
        if r <= 1 { r = 1 }
        coolVol = coolVol * r * (coolT * 250000)
        coolMoles := batch.readName(analyzer, hash("Coolant PA"), "TotalMoles", "Sum")
        batch.writeName(pump, hash("CoolantPump"), "Setting", coolVol/(coolT*coolMoles*8314.46))

        // 温度/压力保护
        press := batch.readName(furnace, hash("A Furnace"), "Pressure", "Maximum")
        temp = batch.readName(furnace, hash("A Furnace"), "Temperature", "Maximum")
        if press > 55000 { press = 55000 }

        overTempLow := temp < mintemp
        overTempHigh := temp > maxtemp
        lowPress := press < minpress
        lowPress = lowPress != 0 ? minpress : 0
        highPress := press > maxpress
        overTempLow = overTempLow | lowPress
        highPress = highPress * 30

        batch.writeName(pump, hash("FuelPump"), "On", overTempLow)
        batch.writeName(pump, hash("CoolantPump"), "On", overTempHigh)
        batch.writeName(furnace, hash("A Furnace"), "SettingOutput", highPress)

        // 检测一批是否完成
        recipe := batch.readName(furnace, hash("A Furnace"), "RecipeHash", "Maximum")
        hashSetting := batch.readName(ic, hash("Hash IC"), "Setting", "Sum")
        open := batch.readName(furnace, hash("A Furnace"), "Open", "Maximum")
        match := recipe == hashSetting

        reagents := batch.readName(furnace, hash("A Furnace"), "Reagents", "Maximum")
        amount := batch.readName(led, hash("Amount"), "Setting", "Maximum")
        ore := batch.readName(dial, hash("Ingot Dial"), "Setting", "Maximum")
        superAlloy := ore > 7
        if amount == 0 {
            match = match & superAlloy
        }
        if ore < 13 {
            reagents = reagents / 4
        }
        amountMatch := (reagents == amount) | (amount == 0)
        done := amountMatch & match

        if (done != 0) || (open != 0) { return }
    }
}
