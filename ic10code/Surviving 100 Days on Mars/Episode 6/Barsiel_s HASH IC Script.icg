// HASH 控制台（Episode 6）。
// 读取两个旋钮选择矿石与数量，按确认按钮把比热写给熔炉 IC；
// 同时根据通风杆控制两个通风口，并维持燃料混合器的配比。
//
// 原脚本用「计算跳转 + 查表」实现矿石 -> (显示值, 比热) 的映射。
// 这里把表放进 IC 自身的设备栈：槽 0..16 是显示哈希，槽 17..33 是对应
// 比热，用 ore 直接索引，避免 17 路 switch 撑爆 128 行预算。

const (
    dial   = 554524804    // 两个旋钮的 deviceHash
    button = 491845673    // 确认按钮
    lever  = 1220484876   // 通风杆
    vent   = -1129453144  // 通风口
)

func main() {
    batch.writeName(dial, hash("Ingot Dial"), "Mode", 17)
    batch.writeName(dial, hash("Amount Dial"), "Mode", 30)
    batch.write(435685051, "On", 1)
    loadTable()

    heat := 0  // 比热，跨 tick 保存；Set 使用上一轮查表结果
    for {
        // 通风杆：0 = 开阀，否则关阀
        if batch.readName(lever, hash("VentLever"), "Open", "Minimum") == 0 {
            ventOn()
        } else {
            ventOff()
        }
        mixer()

        // 读取界面
        ore := batch.readName(dial, hash("Ingot Dial"), "Setting", "Minimum")
        confirm := batch.readName(button, hash("Confirm Button"), "Setting", "Minimum")
        amount := batch.readName(dial, hash("Amount Dial"), "Setting", "Minimum")
        yield()

        // 料斗 CD 为负表示未就绪
        if batch.readName(2037291645, hash("Silos CD"), "Setting", "Minimum") < 0 {
            db.Setting = 0
            continue
        }

        // 数量为 0 时改为 1；矿石编号钳制到 17
        if amount == 0 {
            batch.writeName(dial, hash("Amount Dial"), "Setting", 1)
            amount = 1
        }
        if ore > 17 {
            batch.writeName(dial, hash("Ingot Dial"), "Setting", 17)
            ore = 17
        }

        // 产量 = 数量 × 矿石系数
        qty := amount
        if ore <= 7 { qty *= 50 }
        if ore == 8 { qty *= 200 }
        if ore >= 13 {
            qty *= 50
        } else if ore >= 9 {
            qty *= 100
        }

        if ore <= 0 {
            db.Setting = 0
            continue
        }
        if confirm == 1 {
            set(heat)
        }
        batch.writeName(-815193061, hash("Amount"), "Setting", qty)

        // 查表：设置 IC 宿主显示值与比热（比热供下一轮 Set 使用）
        db.Setting = get(db, ore-1)
        heat = get(db, 16+ore)
    }
}

// loadTable 把矿石 -> (显示哈希, 比热) 写入 IC 设备栈。
func loadTable() {
    put(db, 0, -1301215609)   // Iron
    put(db, 1, -404336834)    // Copper
    put(db, 2, 226410516)     // Gold
    put(db, 3, -290196476)    // Silicon
    put(db, 4, -929742000)    // Silver
    put(db, 5, 2134647745)    // Lead
    put(db, 6, -1406385572)   // Nickel
    put(db, 7, -654790771)    // Steel
    put(db, 8, -297990285)    // Invar
    put(db, 9, -82508479)     // Solder
    put(db, 10, 502280180)    // Electrum
    put(db, 11, 1058547521)   // Constantan
    put(db, 12, 156348098)    // Waspaloy
    put(db, 13, -787796599)   // Inconel
    put(db, 14, 412924554)    // Astroloy
    put(db, 15, 1579842814)   // Hastelloy
    put(db, 16, -1897868623)  // Setllite

    put(db, 17, 0.00950100000010010000)  // Iron
    put(db, 18, 0.00950100000100010000)  // Copper
    put(db, 19, 0.00950100000100010000)  // Gold
    put(db, 20, 0.00950100000100010000)  // Silicon
    put(db, 21, 0.00950100000100010000)  // Silver
    put(db, 22, 0.00950100000100010000)  // Lead
    put(db, 23, 0.00950100000100010000)  // Nickel
    put(db, 24, 0.00900100000100010000)  // Steel
    put(db, 25, 0.01200015001800020000)  // Invar
    put(db, 26, 0.00350005500100010000)  // Solder
    put(db, 27, 0.00600100000080002350)  // Electrum
    put(db, 28, 0.01000100002000055000)  // Constantan
    put(db, 29, 0.00400008005000055000)  // Waspaloy
    put(db, 30, 0.00600100002350023800)  // Inconel
    put(db, 31, 0.01000100003000040000)  // Astroloy
    put(db, 32, 0.00950010002500030000)  // Hastelloy
    put(db, 33, 0.01800100001000019500)  // Setllite
}

// 把比热写给熔炉 IC。
func set(heat num) {
    yield()
    batch.writeName(2037291645, hash("Furnace IC"), "Setting", heat)
}

// 通风口开：Vent1 抽气、Vent2 加压。
func ventOn() {
    batch.writeName(vent, hash("Vent 1"), "Mode", 0)
    batch.writeName(vent, hash("Vent 1"), "PressureExternal", 101)
    batch.writeName(vent, hash("Vent 1"), "PressureInternal", 0)
    batch.writeName(vent, hash("Vent 2"), "Mode", 1)
    batch.writeName(vent, hash("Vent 2"), "PressureExternal", 101)
    batch.writeName(vent, hash("Vent 2"), "PressureInternal", 55000)
    batch.writeName(vent, hash("Vent 1"), "On", 1)
    batch.writeName(vent, hash("Vent 2"), "On", 1)
}

// 通风口关：外部压力归零。
func ventOff() {
    batch.writeName(vent, hash("Vent 1"), "PressureExternal", 0)
    batch.writeName(vent, hash("Vent 2"), "PressureExternal", 0)
}

// 燃料混合器配比：100 / (O2 / (2*H2) + 1)。
func mixer() {
    o2 := batch.readName(435685051, hash("O2 Analyzer"), "Temperature", "Maximum")
    h2 := batch.readName(435685051, hash("H2 Analyzer"), "Temperature", "Maximum")
    batch.writeName(2104106366, hash("Fuel Mixer"), "Setting", 100/(o2/(h2*2)+1))
}
