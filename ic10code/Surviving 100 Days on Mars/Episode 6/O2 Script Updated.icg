// O2 过滤 + 火星大气采集（Episode 6 更新版）。
// O2 过滤器（db）过滤房间 O2；白天高温时从大气采集气体。

func main() {
    for {
        filterOxygen()
        marsGasCapture()
        yield()
    }
}

// 出口压力低于 15MPa 时开启 O2 过滤器。
func filterOxygen() {
    db.Mode = db.PressureOutput < 15000
}

// 白天（>6.5℃）且罐压低于 15MPa 时开启大通风口采集大气。
func marsGasCapture() {
    temp := d1.Temperature - 273
    d0.On = (temp > 6.5) && (db.PressureInput < 15000)
}
