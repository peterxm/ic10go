// 燃烧离心机启动器（Episode 9）。
// 依次启动两台离心机：确认转速与应力都归零后再开机。db.Setting 用于调试显示状态。

func main() {
    for {
        if d0.On == 0 {
            turnOnCC1()
            continue
        }
        if d1.On == 0 {
            turnOnCC2()
            continue
        }
        db.Setting = 0  // 两台都运行中
    }
}

// 启动离心机 1：转速与应力都归零前，持续压油门与燃烧限制。
func turnOnCC1() {
    db.Setting = 1
    for (d0.Rpm != 0) || (d0.Stress != 0) {
        d0.Throttle = 0
        d0.CombustionLimiter = 0
    }
    d0.On = 1
}

// 启动离心机 2。
func turnOnCC2() {
    db.Setting = 2
    for (d1.Rpm != 0) || (d1.Stress != 0) {
        d1.Throttle = 0
        d1.CombustionLimiter = 0
    }
    d1.On = 1
}
