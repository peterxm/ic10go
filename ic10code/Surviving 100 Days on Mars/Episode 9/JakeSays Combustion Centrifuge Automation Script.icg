// 燃烧离心机自动化（Episode 9）。
// 状态机：Init -> 分阶段升油门 -> Operation（正常出料 / 紧急断电）-> Empty -> Init。

func main() {
    for {
        initCC()
        start()
        operation()
    }
}

// 等待应力降到 10 以下。
func initCC() {
    for db.Stress > 10 { }
}

// 分阶段启动：先泄压，再把转速拉到 275，最后油门 100 + 燃烧限制 20。
func start() {
    db.Open = 0
    db.Throttle = 10
    for db.Stress < 50 { }

    db.Throttle = 0
    for db.Stress > 45 { }

    for db.Rpm < 125 { }
    db.Throttle = 50

    for db.Rpm < 275 { }
    db.Throttle = 100
    db.CombustionLimiter = 20
}

// 正常运行：出料满 1000 或油门/转速异常时切换状态。
func operation() {
    for {
        processed := db.Reagents
        if processed >= 1000 {
            empty()
            return
        }
        // 紧急断电：油门 >= 20 但转速仍 <= 100
        if (db.Throttle >= 20) && (db.Rpm <= 100) {
            emergency()
            return
        }
        d0.Setting = processed
    }
}

// 清空：关油门/限制/主机，等转速降到 50 以下，开阀，等反应物少于 20 后重新初始化。
func empty() {
    db.Throttle = 0
    db.CombustionLimiter = 0
    db.On = 0
    for db.Rpm > 50 { }
    db.Open = 1
    for db.Reagents >= 20 { }
}

// 紧急停机：关油门与燃烧限制，等应力降到 10 以下。
func emergency() {
    db.Throttle = 0
    db.CombustionLimiter = 0
    for db.Stress > 10 { }
}
