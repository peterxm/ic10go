#This script will track the sun on Mars. You need to use the Solar Panel (Dual) with
#the power port facing towards the 90 degree heading. The daylight sensor's data port
#must also face 90 degrees. Set the sensor to pin d0

#Naming variables
alias sensor d0
define solarPanel -539224550
alias vertical r0
alias horizontal r1

#Start tracking program
tracking:
yield
#set panel vertical angle
l vertical sensor Vertical
sub vertical 90 vertical
sb solarPanel Vertical vertical

#set panel horizontal angle
l horizontal sensor Horizontal
sub horizontal horizontal 90
sb solarPanel Horizontal horizontal

#loop
j tracking