// 太阳能追踪 + 压力管理（V1.2，Episode 5）。
// 追踪太阳的同时，东西两侧压力高于 0.1 时开启对应通风口。

const solarPanel = -539224550

func main() {
    for {
        yield()
        tracking()

        // 东西两侧压力高于 0.1 时开启对应通风口
        d1.On = d3.Pressure > 0.1
        d2.On = d4.Pressure > 0.1
    }
}

// 把面板角度对准太阳。
func tracking() {
    batch.write(solarPanel, "Vertical", 90-d0.Vertical)
    batch.write(solarPanel, "Horizontal", d0.Horizontal-270)
}
