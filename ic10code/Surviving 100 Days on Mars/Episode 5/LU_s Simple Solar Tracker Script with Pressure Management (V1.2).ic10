#Naming variables
alias sensor d0
alias eastVent d1
alias westVent d2
alias westSensor d3
alias eastSensor d4
define solarPanel -539224550
alias vertical r0
alias horizontal r1
alias westPressure r2
alias eastPressure r3

main:
yield
jal tracking
l westPressure westSensor Pressure
l eastPressure eastSensor Pressure
sgt westPressure westPressure 0.1
sgt eastPressure eastPressure 0.1
s westVent On westPressure
s eastVent On eastPressure

j main
#Start tracking program
tracking:
#set panel vertical angle
l vertical sensor Vertical
sub vertical 90 vertical
sb solarPanel Vertical vertical

#set panel horizontal angle
l horizontal sensor Horizontal
sub horizontal horizontal 270
sb solarPanel Horizontal horizontal

#loop
j ra