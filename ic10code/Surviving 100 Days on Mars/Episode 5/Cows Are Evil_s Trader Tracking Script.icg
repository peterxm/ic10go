// 卫星/交易信号追踪（Episode 5）。
// 雷达（d0）扫描天空；找到足够强的信号后等待用户按 resume 键锁定。

func main() {
    oldSignal := 0
    for {
        // 复位扫描参数
        hangle := 0
        vangle := 90
        step := 4

        // 扫描：水平方向来回扫，每扫完一轮把垂直角降低 5°
        for {
            if d2.Setting != 0 { break }  // reset 键：重新开始

            d0.Horizontal = hangle
            d0.Vertical = vangle
            sleep(0.5)

            signal := d0.SignalID
            strength := d0.SignalStrength
            if strength >= 0.95 {
                // 新信号：等待用户按 resume 键
                if signal != oldSignal {
                    for d1.Setting == 0 {
                        yield()
                    }
                    oldSignal = signal
                }
            }

            hangle += step
            if (hangle >= 360) || (hangle <= 0) {
                step = -step
                vangle -= 5
                if vangle <= 0 { break }  // 扫完整个天空，回到 reset
            }
        }
    }
}
