#Naming Variables
alias CO2Filter db
alias gasMixer d0
alias analyzer d1
define pipeHeater -419758574
alias outputPressure r0
alias turnOn r1
move turnOn 0
alias linePressure r2
alias lineTemperature r3

main:
jal filterCO2
jal greenhouseGasCheck
yield
j main

#filter CO2 out of the room if certain conditions are met
filterCO2:
l outputPressure CO2Filter PressureOutput #checks the pressure on the output pipe
slt turnOn outputPressure 15000 #sets 'turnOn' to '1' if the presure is under 15Mpa
s CO2Filter Mode turnOn #turns on the filter until pressure reaches 1Mpa
yield
j ra

#Monitor and maintain gas temperature in greenhouse return line
greenhouseGasCheck:
sb pipeHeater On 0
l linePressure analyzer Pressure
l lineTemperature analyzer Temperature
sub lineTemperature lineTemperature 273 #convert temp to Celcius
blt lineTemperature 25 gasHeaters #run heating function if line is colder than 25C
slt r5 linePressure 1000
sge r6 lineTemperature 25
or turnOn r5 r6
s gasMixer On turnOn
yield
j ra

#turns on heaters to
gasHeaters:
s gasMixer On 0
sb pipeHeater On 1
l lineTemperature analyzer Temperature
sub lineTemperature lineTemperature 273 #convert temp to Celcius
blt lineTemperature 25 gasHeaters #run heating function if line is colder than 25C
bge lineTemperature 25 greenhouseGasCheck #run heating function if line is colder than 25C
yield
j ra