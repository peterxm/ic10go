alias sorter1 d0

s sorter1 Mode 2

#item setup
move r0 871811564 #road flare hash code
sll r0 r0 8
add r0 r0 SorterInstruction.FilterPrefabHashEquals

move r1 1021053608 #Kit(Insulated Tank) hash code
sll r1 r1 8
add r1 r1 SorterInstruction.FilterPrefabHashEquals

move r2 SlotClass.Battery
sll r2 r2 16
add r2 r2 SorterInstruction.FilterSlotTypeCompare

move r3 SortingClass.Ores
sll r3 r3 16
add r3 r3 SorterInstruction.FilterSortingClassCompare

put sorter1 0 r0
put sorter1 1 r1
put sorter1 2 r2
put sorter1 3 r3
