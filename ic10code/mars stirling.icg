// 火星斯特林发动机控制：由拉杆决定总开关；用气体传感器读数做压力/温度滞回。
// d0=进气阀，d1=排气阀，d2=气体传感器，d3=发电机，d4=拉杆。

func main() {
    d0.Mode = 1
    d1.Mode = 1
    for {
        d3.On = d4.Setting // 拉杆控制发电机总开关

        p := d2.Pressure
        t := d2.Temperature

        // 压力过低：先补气一个 tick 再判断
        if p <= 25 {
            d0.On = 1
            yield()
            d0.On = 0
        }

        // 压力滞回：>=100 排气，<100 停止排气
        if p >= 100 {
            d1.On = 1
        } else {
            d1.On = 0
        }

        // 温度滞回：>=320 补气，<310 停止补气
        if t >= 320 {
            d0.On = 1
        } else if t < 310 {
            d0.On = 0
        }
    }
}
