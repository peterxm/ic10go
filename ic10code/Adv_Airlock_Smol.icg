// Adv Airlock (Smol) port: a compact two-door airlock state machine.
//
// The original packs the door/vent control bits into one number and rotates
// the active phase until exactly one door bit is set, then applies the phase
// to the doors and vents and writes the bits back for the logic network.
//
// d0=exterior door, d1=exterior vent, d2=interior vent, d3=interior door,
// d4=pressure sensor.

const (
    pressureIn = 100
    pressureEx = 0

    doorEx = d0
    ventEx = d1
    ventIn = d2
    doorIn = d3
    sensor = d4
)

func main() {
    for {
        yield()
        inVentMode := ventIn.Mode
        pressure := sensor.Pressure

        // Assemble the phase bits from the door/vent control values.
        state := ((doorIn.Setting & 1) << 7) | ((doorEx.Setting & 1) << 4) |
            ((doorIn.Open & 1) << 3) | ((ventIn.On & 1) << 2) |
            ((ventEx.On & 1) << 1) | (doorEx.Open & 1)

        doorTriggered := ((state >> 4) ^ state) & 9
        state &= 15

        // Rotate until a single, valid phase is selected. If the state is
        // empty or has more than one bit set, wait for the next cycle.
        doEnd := false
        retry := true
        for retry {
            retry = false
            t := state & 8
            if t != 0 { t = 14 } else { t = 15 }
            state &= t
            if state != 0 && ((state-1)&state) == 0 {
                t = state & 9
                if t != 0 { inVentMode = state >> 3 }

                trig := doorTriggered != 0
                if !trig {
                    doEnd = true
                    if t == 0 {
                        t2 := 2 << inVentMode
                        if state == t2 {
                            trig = pressure == 0
                        } else {
                            t3 := pressureIn
                            if inVentMode != 0 { t3 = pressureEx }
                            trig = pressure >= t3
                        }
                    }
                }
                if trig {
                    doEnd = false
                    doorTriggered = 0
                    if inVentMode != 0 { state = state * 0.5 } else { state = state * 2 }
                    retry = true
                }
            }
        }
        if !doEnd { continue }

        // Apply the phase and publish the bits back to the devices.
        state = (state & 15) | ((state & 15) << 4)
        doorEx.Mode = 1
        doorIn.Mode = 1
        ventIn.Mode = inVentMode
        ventEx.Mode = inVentMode == 0

        doorIn.Setting = (state >> 7) & 1
        doorEx.Setting = (state >> 4) & 1
        doorIn.Open = (state >> 3) & 1
        ventIn.On = (state >> 2) & 1
        ventEx.On = (state >> 1) & 1
        doorEx.Open = state & 1
    }
}
