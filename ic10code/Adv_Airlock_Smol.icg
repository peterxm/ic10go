// Adv Airlock (Smol) port.
//
// The original packs the door/vent control bits into one number. To stay as
// compact as the hand-minified IC10, this port keeps the same bit-packing
// approach: it pokes the logic types onto the stack, builds the phase by
// reading each device, rotates the active bit, then writes the result back.
//
// d0=exterior door, d1=exterior vent, d2=interior vent, d3=interior door,
// d4=pressure sensor.

const (
    pressureIn = 100
    pressureEx = 0

    doorEx = d0
    ventEx = d1
    ventIn = d2
    doorIn = d3
    sensor = d4
)

func main() {
    // Logic type read/written for each device, in stack order.
    poke(0, LogicType.Open)
    poke(1, LogicType.On)
    poke(2, LogicType.On)
    poke(3, LogicType.Open)
    poke(4, LogicType.Setting)
    poke(7, LogicType.Setting)

    var state = 0
    var inVentMode = 0
    var pressure = 0
    var doorTriggered = 0

    label main:
    yield()
    inVentMode = ventIn.Mode
    pressure = sensor.Pressure

    // Build the phase bits from the devices.
    sp = 8
    label load:
    logicType := pop()
    if logicType == 0 { goto loaded }
    device := sp % 4
    state = ins(readDev(device, logicType), sp, 1)
    label loaded:
    if sp > 0 { goto load }

    doorTriggered = ((state >> 4) ^ state) & 9
    state = state & 15

    // Rotate until exactly one valid phase bit is set.
    label loop:
    temp := state & 8
    temp = (temp != 0 ? 14 : 15)
    state = state & temp
    if state == 0 { goto main }
    temp = (state - 1) & state
    if temp != 0 { goto main }
    temp = state & 9
    device = state >> 3
    inVentMode = (temp != 0 ? device : inVentMode)
    if doorTriggered != 0 { goto trigger }
    if temp != 0 { goto end }
    temp = 2 << inVentMode
    if state != temp { goto checkPressure }
    if pressure == 0 { goto trigger }
    label checkPressure:
    if state == temp { goto end }
    temp = (inVentMode != 0 ? pressureEx : pressureIn)
    if pressure >= temp { goto trigger }

    // Apply the phase and publish the bits back to the devices.
    label end:
    state = ins(state, 4, 4)
    doorEx.Mode = 1
    doorIn.Mode = 1
    ventIn.Mode = inVentMode
    ventEx.Mode = inVentMode == 0
    sp = 8
    label store:
    logicType = pop()
    if logicType == 0 { goto stored }
    device = sp % 4
    writeDev(device, logicType, (state >> sp) & 1)
    label stored:
    if sp > 0 { goto store }
    goto main

    // Shift the active phase and re-check.
    label trigger:
    doorTriggered = 0
    temp = (inVentMode != 0 ? 0.5 : 2)
    state = state * temp
    goto loop
}
