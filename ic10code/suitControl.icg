// 宇航服 + 头盔自动安全 + 生命维持联动（Hardsuit IC）。
// 芯片插在宇航服 IC 槽：db = 宇航服，d0 = 头盔。
// 外部环境不安全时自动关闭并锁住头盔（仅在状态变化时写入，绝不自动打开）；
// 面罩打开 -> 关闭过滤/空调/供气，关闭 -> 开启（同样仅在变化时写入）。

const (
    tMin   = 273.15
    tMax   = 313.15
    pMin   = 35
    pMax   = 125
    o2Min  = 0.15
    toxMax = 0.02
)

func main() {
    var lastLife = -1
    var lastAlert = -1
    for {
        yield()
        if isUnset(d0) { continue } // 没装头盔：跳过
        u := unsafeState()
        if u != lastAlert { // 仅在告警状态变化时动作
            lastAlert = u
            if u != 0 {
                alertAndClose()
            } else {
                clearAlert()
            }
        }
        life := d0.Open == 0 // 面罩关闭时维持生命支持
        if life != lastLife {
            lastLife = life
            db.Filtration = life
            db.On = life
            db.AirRelease = life
        }
    }
}

// 汇总所有不安全因素：压力、温度、有毒气体、氧气过低。
func unsafeState() num {
    var u = 0
    if db.PressureExternal < pMin { u = 1 }
    if db.PressureExternal > pMax { u = 1 }
    if db.TemperatureExternal > tMax { u = 1 }
    if db.TemperatureExternal < tMin { u = 1 }

    tox := d0.RatioCarbonDioxide + d0.RatioMethane + d0.RatioPollutant + d0.RatioNitrousOxide + d0.RatioHydrazine + d0.RatioSilanol + d0.RatioHydrochloricAcid
    if tox > toxMax { u = 1 }

    if d0.RatioOxygen < o2Min { u = 1 }
    return u
}

// 变为不安全：报警；若面罩还开着就关闭并上锁（绝不自动打开）。
func alertAndClose() {
    db.Error = 1
    if d0.Open != 0 {
        d0.Open = 0
        d0.Lock = 1
    }
}

// 恢复安全：清除报警并解锁。
func clearAlert() {
    db.Error = 0
    d0.Lock = 0
}
