// Dirci 售货机补给调度器
//
// 由原 IC10 脚本改写，使用 ic10c 的「函数接收设备 / data 表参数」特性：
//   - occupied(dev, first, last)  统计设备槽位区间内的占用数
//   - loadRoute(route)            把路线表写入 db 的地址 0..11
//
// 原脚本的几处问题（这里已修正）：
//   - vending2 从未 alias（这里假定为 d3）
//   - 数槽循环后的 brnez 判的是循环计数器而非占用数，targetStatus 永不赋值
//   - move r0 2 覆盖了就绪判断结果，后续 and 用错寄存器
//   - vending1route / vending2route 是死代码，且两份内容完全相同
//
// 每轮：
//   1. 统计两台售货机槽位 2..101 的占用数，选出需要补货的目标；
//   2. 检查 Dirci 是否就绪：例行程序在卸载点、空载、空闲；
//   3. 就绪时召回 Dirci，并把对应路线写入它的内存地址 0..11。

const vending1 = d0
const vending2 = d3
const robotXmitter = d1
const dirciRoutine = d2

// 路线表（各 12 个 prefab hash）；原脚本两条相同，按需改成各自的路线。
data Route1 = [ -277, -1207, -275, -1209, -274, -1237, -256, -1236, -232, -1044, -214, -1016 ]
data Route2 = [ -277, -1207, -275, -1209, -274, -1237, -256, -1236, -232, -1044, -214, -1016 ]

// 统计设备 dev 在槽位 [first, last) 内的占用数。
func occupied(dev, first, last) num {
    n := 0
    for i := first; i < last; i++ {
        n += dev.slot[i].Occupied
    }
    return n
}

// 把路线表 route 的 12 个值写入 db 的地址 0..11。
func loadRoute(route) {
    for i := 0; i < 12; i++ {
        put(db, i, route[i])
    }
}

func main() {
    for {
        yield()

        // 选出需要补货的售货机（后者优先）
        target := 0
        if occupied(vending1, 2, 102) > 0 { target = 1 }
        if occupied(vending2, 2, 102) > 0 { target = 2 }
        if target == 0 { continue }

        // Dirci 就绪：例行程序在卸载点、空载、空闲
        ready := get(dirciRoutine, ra) <= 8
        ready = ready && occupied(robotXmitter, 2, 12) == 0
        ready = ready && robotXmitter.Mode == 0
        if !ready { continue }

        // 召回并装载路线
        db.Setting = 1
        if target == 1 { loadRoute(Route1) } else { loadRoute(Route2) }
    }
}
