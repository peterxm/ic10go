// Aimee 简易漫游测试脚本（往返于矿区与卸载点）。
//
// 原脚本：AIMeE/useless/baseFriend.ic10
// 设备：d0 = 机器人发射器、d1 = 召回拉杆。

func main() {
    var r2 = 0
    var r6 = 0
    d0.Mode = 0
    label unload:
    r3 := get(db, 511)
    call batteryWeatherCheckRecall
    if r6 != 0 { goto L14 }
    sp = 0
    label L14:
    goto goingToWork
    label goingHomeStart:
    sp = (sp + 1)
    label L18:
    call batteryWeatherCheckRecall
    if sp <= 1 { goto unload }
    sp = (sp - 1)
    r5 := peek()
    sp = (sp - 1)
    r4 := peek()
    r0 := -1
    r4 = (r4 + r0)
    r5 = (r5 + r0)
    d0.TargetX = r4
    d0.TargetZ = r5
    call travel
    goto L18
    label goingToWork:
    call batteryWeatherCheckRecall
    if r6 != 0 { goto goingHomeStart }
    sp = (sp + 1)
    r4 = peek()
    sp = (sp + 1)
    r5 = peek()
    r0 = 1
    r4 = (r4 + r0)
    r5 = (r5 + r0)
    d0.TargetX = r4
    d0.TargetZ = r5
    call travel
    if sp >= r3 { goto unload }
    goto goingToWork
    label travel:
    d0.Mode = 2
    r15 := ra
    label L51:
    r0 = d0.PositionY
    d0.TargetY = r0
    call batteryWeatherCheckRecall
    if r6 == 0 { goto L59 }
    if r15 < goingToWork { goto L59 }
    r15 = goingHomeStart
    sp = (sp - 2)
    d0.Mode = 0
    label L59:
    r0 = d0.VelocityMagnitude
    r0 = (r0 < 0.2)
    r2 = (r2 * r0)
    r2 = (r2 + r0)
    if r2 >= 70 { goto pathfind }
    yield()
    r0 = d0.Mode
    if r0 != 0 { goto L51 }
    jump(r15)
    label pathfind:
    d0.Mode = 5
    sleep(10)
    d0.Mode = 2
    r2 = 0
    goto L51
    label batteryWeatherCheckRecall:
    put(db, 507, sp)
    put(db, 506, ra)
    put(db, 505, r2)
    r0 = d0.slot[0].Damage
    r1 := d0.slot[0].Charge
    r1 = (r1 < 70000)
    r6 = (r0 | r1)
    if r6 != 0 { goto L91 }
    r0 = d1.Setting
    r6 = (r6 | r0)
    if r0 == 0 { goto L91 }
    db.Setting = 0
    r7 := 0
    goto L92
    label L91:
    db.Setting = r6
    label L92:
    r0 = batch.read(1997212478, "NextWeatherEventTime", "Sum")
    r6 = (r6 | r0)
    ret
}
