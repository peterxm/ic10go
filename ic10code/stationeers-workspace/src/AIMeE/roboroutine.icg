// Aimee 采矿例行程序：待机 → 前往矿区 → 采矿 → 返回卸载。
//
// 原脚本：AIMeE/roboroutine.ic10
// 设备：d0 = 机器人发射器、d1 = 召回拉杆、d2 = 二级召回。
// 保留原脚本的运行时标签地址比较（`if r15 < goingToWork`）。

func main() {
    var r0 = 0
    var r14 = 0
    d0.Mode = 0
    label arrivedHome:
    sp = 0
    r12 := get(db, 511)
    if r14 != 1 { goto L9 }
    d0.Mode = 4
    label L9:
    call batteryWeatherCheckRecall
    if r0 != 0 { goto L9 }
    label unloadWait:
    d0.Mode = 4
    yield()
    r0 = d0.Mode
    if r0 == 4 { goto unloadWait }
    if r0 == 0 { goto goingToWork }
    label goingHomeStart:
    sp = (sp + 1)
    label goingHomeLoop:
    call batteryWeatherCheckRecall
    if sp <= 1 { goto arrivedHome }
    sp = (sp - 1)
    r3 := peek()
    sp = (sp - 1)
    r2 := peek()
    r2 = (r2 - 1)
    r3 = (r3 - 1)
    d0.TargetX = r2
    d0.TargetZ = r3
    call travel
    goto goingHomeLoop
    label goingToWork:
    call batteryWeatherCheckRecall
    if r0 != 0 { goto goingHomeStart }
    sp = (sp + 1)
    r2 = peek()
    sp = (sp + 1)
    r3 = peek()
    if sp < r12 { goto noOffset }
    call getOffset
    r2 = (r2 + r0)
    call getOffset
    r3 = (r3 + r0)
    label noOffset:
    d0.TargetX = r2
    d0.TargetZ = r3
    call travel
    if sp >= r12 { goto workSite }
    goto goingToWork
    label getOffset:
    r1 := get(db, 507)
    r0 = rand()
    r0 = (r1 * r0)
    r1 = rand()
    if r1 > 0.5 { goto L57 }
    r0 = (r0 * -1)
    label L57:
    ret
    label workSite:
    d0.Mode = 3
    r13 := 0
    label miningWaitLoop:
    call batteryWeatherCheckRecall
    if r0 != 0 { goto goingHomeStart }
    r13 = (r13 + 1)
    r0 = get(db, 508)
    if r13 < r0 { goto L74 }
    r1 = get(db, 509)
    r0 = d0.MineablesInVicinity
    if r0 <= r1 { goto L72 }
    sp = (sp - 2)
    goto goingToWork
    label L72:
    r14 = 1
    goto goingHomeStart
    label L74:
    yield()
    r0 = d0.Mode
    if r0 == 3 { goto miningWaitLoop }
    if r0 == 6 { goto goingHomeStart }
    goto workSite
    label travel:
    r15 := ra
    label travelLoop:
    d0.Mode = 2
    r0 = d0.PositionY
    d0.TargetY = r0
    call batteryWeatherCheckRecall
    if r0 == 0 { goto L91 }
    if r15 < goingToWork { goto L91 }
    r15 = goingHomeStart
    sp = (sp - 2)
    d0.Mode = 0
    label L91:
    yield()
    r0 = d0.Mode
    if r0 != 0 { goto travelLoop }
    jump(r15)
    label batteryWeatherCheckRecall:
    r0 = d1.Setting
    if isUnset(d2) { goto L100 }
    r1 = d2.Setting
    r3 = (r0 | r1)
    label L100:
    if r0 == 0 { goto L102 }
    r14 = 0
    label L102:
    r0 = d0.slot[0].Charge
    r1 = get(db, 510)
    r2 = (r0 < r1)
    r2 = (r2 | r14)
    db.Setting = r2
    r0 = batch.read(1997212478, "NextWeatherEventTime", "Sum")
    r0 = (r0 != 0)
    r0 = (r0 | r3)
    r0 = (r2 | r0)
    ret
}
