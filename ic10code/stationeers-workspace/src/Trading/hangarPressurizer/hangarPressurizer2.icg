// 机库增压器 v2：带降落台状态与占用传感器联锁的增压/泄压循环。
//
// 原脚本：Trading/hangarPressurizer/hangarPressurizer2.ic10
// 设备：d0 = 气体传感器、d1 = 开关、d2 = 状态屏、d3 = 压力屏、
//       d4 = 降落台电源数据。
// 只有降落台落地（Mode == 4）才允许增压；检测到玩家占用时禁止泄压。

const gasSensor = d0
const switchDev = d1
const stateDisplay = d2
const pressureDisplay = d3
const landingPadDataPower = d4

const ventHash = -785498334
const occupancySensorHash = 322782515
const blastDoorHash = 337416191
const largeHangar = -1351081801

const interiorVent = hash("Interior Vent")
const exteriorVent = hash("Exterior Vent")

const minPress = 150

// 读气体压力（kPa→Pa）并写到压力屏。
func showPressure() {
    pressureDisplay.Mode = 14
    pressureDisplay.Setting = gasSensor.Pressure * 1000
}

func main() {
    label idle:
    batch.writeName(ventHash, interiorVent, "On", 0)
    if switchDev.Setting == 1 { goto requestPressurize }

    stateDisplay.Mode = 10
    stateDisplay.Setting = str("Idle")
    showPressure()
    yield()
    goto idle

    label requestPressurize:
    if landingPadDataPower.Mode != 4 { goto requestDepressurize }
    goto evacuate

    label safe:
    batch.writeName(ventHash, interiorVent, "On", 0)
    if switchDev.Setting == 0 { goto requestDepressurize }
    if landingPadDataPower.Mode != 4 { goto requestDepressurize }

    stateDisplay.Mode = 10
    stateDisplay.Setting = str("Idle")
    if gasSensor.Pressure < minPress { goto pressurize }

    batch.write(blastDoorHash, "Lock", 0)
    batch.write(blastDoorHash, "Open", 1)
    showPressure()
    yield()
    goto safe

    label requestDepressurize:
    batch.write(blastDoorHash, "Open", 0)
    batch.write(blastDoorHash, "Lock", 1)
    if batch.read(occupancySensorHash, "Activate", "Maximum") == 1 { goto safe }
    goto depressurize

    label evacuate:
    batch.write(largeHangar, "Open", 0)
    batch.writeName(ventHash, exteriorVent, "On", 1)
    if switchDev.Setting == 0 { goto requestDepressurize }
    if landingPadDataPower.Mode != 4 { goto requestDepressurize }

    stateDisplay.Mode = 10
    stateDisplay.Setting = str("Evac")
    if gasSensor.Pressure == 0 { goto pressurize }

    showPressure()
    yield()
    goto evacuate

    label pressurize:
    batch.writeName(ventHash, exteriorVent, "On", 0)
    batch.writeName(ventHash, interiorVent, "Mode", 0)
    batch.writeName(ventHash, interiorVent, "On", 1)
    if switchDev.Setting == 0 { goto requestDepressurize }
    if landingPadDataPower.Mode != 4 { goto requestDepressurize }

    stateDisplay.Mode = 10
    stateDisplay.Setting = str("Fill")
    if gasSensor.Pressure >= minPress { goto safe }

    showPressure()
    yield()
    goto pressurize

    label depressurize:
    batch.write(blastDoorHash, "Open", 0)
    batch.write(blastDoorHash, "Lock", 1)
    if batch.read(occupancySensorHash, "Activate", "Maximum") == 1 { goto safe }
    if switchDev.Setting == 1 && landingPadDataPower.Mode == 4 { goto evacuate }

    batch.writeName(ventHash, interiorVent, "Mode", 1)
    batch.writeName(ventHash, interiorVent, "On", 1)
    stateDisplay.Mode = 10
    stateDisplay.Setting = str("Empty")
    if gasSensor.Pressure <= 0 {
        batch.write(largeHangar, "Open", 1)
        goto idle
    }

    showPressure()
    yield()
    goto depressurize
}
