// 交易求解器：根据三个参考点解算交易者坐标（可粘贴版本）。
//
// 原脚本：Trading/autoTrader/traderSolver.ic10
// 相比 solverLarge 多了垂直角校正：V = V - 6.88*sin(V*deg2rada)，
// 以及反向求解的牛顿迭代（invertVLoop）。
//
// 用 reserveRegs(2,10) 把 r2..r10 留给 3 组 XYZ：转换写成循环用
// setIreg 间接写入，克拉默法则用 ireg(常量) 直接当寄存器操作数，
// 与原脚本一样零拷贝。

const b = 6.88
const deg2rada = 0.0694117438141256949
const deg2radab = 0.477552797441184780912

func main() {
    reserveRegs(2, 10)
    var r0 = 0
    var r1 = 0
    var ptr = 0
    var h = 0
    var v = 0
    var e = 0
    var d = 0
    var a = 0
    var bb = 0
    var c = 0
    var tx = 0
    var ty = 0
    var tz = 0
    var vv = 0
    var iter = 0

    label wait:
    yield()
    if db.Setting == 0 { goto wait }

    // 把 3 组 HVE 转成 XYZ 写入 r2..r10，E 存宿主栈（地址 8/5/2）
    sp = 9
    ptr = 2
    label convert:
    e = pop()
    v = pop()
    h = pop()
    h = h * deg2rad
    v = v - b * sin(v * deg2rada)
    v = v * deg2rad
    setIreg(ptr, -sin(v) * cos(h))
    ptr = ptr + 1
    setIreg(ptr, cos(v))
    ptr = ptr + 1
    setIreg(ptr, sin(v) * sin(h))
    ptr = ptr + 1
    put(db, sp + 2, cos(e * deg2rad))
    if sp != 0 { goto convert }

    // 2x2 子行列式（r2..r10 分别为 x0,y0,z0,x1,y1,z1,x2,y2,z2）
    a = ireg(6) * ireg(10) - ireg(7) * ireg(9)   // Y1*Z2 - Z1*Y2
    bb = ireg(5) * ireg(10) - ireg(7) * ireg(8)  // X1*Z2 - Z1*X2
    c = ireg(5) * ireg(9) - ireg(6) * ireg(8)    // X1*Y2 - Y1*X2
    d = ireg(2)*a - ireg(3)*bb + ireg(4)*c

    // 克拉默法则
    tx = (a*get(db, 8) - (ireg(3)*ireg(10)-ireg(4)*ireg(9))*get(db, 5) +
        (ireg(3)*ireg(7)-ireg(4)*ireg(6))*get(db, 2)) / d
    ty = ((ireg(2)*ireg(10)-ireg(4)*ireg(8))*get(db, 5) - bb*get(db, 8) -
        (ireg(2)*ireg(7)-ireg(4)*ireg(5))*get(db, 2)) / d
    tz = (c*get(db, 8) - (ireg(2)*ireg(9)-ireg(3)*ireg(8))*get(db, 5) +
        (ireg(2)*ireg(6)-ireg(3)*ireg(5))*get(db, 2)) / d

    // 转回 HV（V 为未校正值）
    h = atan2(tz, tx * -1) * rad2deg
    vv = atan2(sqrt(tx*tx + tz*tz), ty) * rad2deg

    // 牛顿迭代反解垂直角校正
    v = vv
    iter = 3
    label invertVLoop:
    r0 = v - b * sin(v * deg2rada)
    r0 = r0 - vv
    r1 = 1 - deg2radab * cos(v * deg2rada)
    r0 = r0 / r1
    v = v - r0
    iter = iter - 1
    if iter >= 0 { goto invertVLoop }

    put(db, 0, h)
    put(db, 1, v)
    db.Setting = 0
    goto wait
}
