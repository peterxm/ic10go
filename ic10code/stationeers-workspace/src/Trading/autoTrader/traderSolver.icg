// 交易求解器：根据三个参考点解算交易者坐标（可粘贴版本）。
//
// 原脚本：Trading/autoTrader/traderSolver.ic10
// 相比 solverLarge 多了垂直角校正：V = V - 6.88*sin(V*deg2rada)，
// 以及反向求解的牛顿迭代（invertVLoop）。
//
// 注意：本端口按原脚本逐项计算，寄存器压力较大，编译约 184 行，超过 128 行
// 预算（原脚本用满 16 个寄存器 + 间接寄存器寻址）。保留为参考移植，
// 不参与端口等价测试（见 knownUnsupported）。


const b = 6.88
const deg2rada = 0.0694117438141256949
const deg2radab = 0.477552797441184780912

func main() {
    var r0 = 0
    var r2 = 0
    var r1 = 0
    var x0 = 0
    var y0 = 0
    var z0 = 0
    var x1 = 0
    var y1 = 0
    var z1 = 0
    var x2 = 0
    var y2 = 0
    var z2 = 0
    var h = 0
    var v = 0
    var e = 0
    var d = 0
    var tx = 0
    var ty = 0
    var tz = 0
    var vv = 0

    label wait:
    yield()
    if db.Setting == 0 { goto wait }

    sp = 9

    // 第 1 组
    e = pop()
    v = pop()
    h = pop()
    h = h * deg2rad
    v = v - b * sin(v * deg2rada)
    v = v * deg2rad
    x0 = -sin(v) * cos(h)
    y0 = cos(v)
    z0 = sin(v) * sin(h)
    put(db, 8, cos(e * deg2rad))

    // 第 2 组
    e = pop()
    v = pop()
    h = pop()
    h = h * deg2rad
    v = v - b * sin(v * deg2rada)
    v = v * deg2rad
    x1 = -sin(v) * cos(h)
    y1 = cos(v)
    z1 = sin(v) * sin(h)
    put(db, 5, cos(e * deg2rad))

    // 第 3 组
    e = pop()
    v = pop()
    h = pop()
    h = h * deg2rad
    v = v - b * sin(v * deg2rada)
    v = v * deg2rad
    x2 = -sin(v) * cos(h)
    y2 = cos(v)
    z2 = sin(v) * sin(h)
    put(db, 2, cos(e * deg2rad))

    // 行列式 d = X0*(Y1*Z2-Z1*Y2) - Y0*(X1*Z2-Z1*X2) + Z0*(X1*Y2-Y1*X2)
    r0 = x1 * z2
    r1 = z1 * x2
    r0 = r0 - r1
    d = y0 * r0
    r0 = x1 * y2
    r1 = y1 * x2
    r0 = r0 - r1
    r0 = z0 * r0
    d = r0 - d
    r0 = y1 * z2
    r1 = z1 * y2
    r1 = r0 - r1
    r0 = x0 * r1
    d = d + r0

    // 克拉默法则
    r0 = get(db, 8)
    tx = r1 * r0
    r0 = y0 * z2
    r1 = z0 * y2
    r0 = r0 - r1
    r1 = get(db, 5)
    r0 = r0 * r1
    tx = tx - r0
    r0 = y0 * z1
    r1 = z0 * y1
    r0 = r0 - r1
    r1 = get(db, 2)
    r0 = r0 * r1
    tx = tx + r0
    tx = tx / d

    r0 = x0 * z1
    r1 = z0 * x1
    ty = r0 - r1
    ty = ty * get(db, 2)
    r0 = x0 * z2
    r1 = z0 * x2
    r0 = r0 - r1
    r1 = get(db, 5)
    r0 = r0 * r1
    ty = r0 - ty
    r0 = x1 * z2
    r1 = z1 * x2
    r0 = r0 - r1
    r1 = get(db, 8)
    r0 = r0 * r1
    ty = ty - r0
    ty = ty / d

    r0 = x1 * y2
    r1 = y1 * x2
    tz = r0 - r1
    tz = tz * get(db, 8)
    r0 = x0 * y2
    r1 = y0 * x2
    r0 = r0 - r1
    r1 = get(db, 5)
    r0 = r0 * r1
    tz = tz - r0
    r0 = x0 * y1
    r1 = y0 * x1
    r0 = r0 - r1
    r1 = get(db, 2)
    r0 = r0 * r1
    tz = tz + r0
    tz = tz / d

    // 转回 HV（V 为未校正值）
    h = atan2(tz, tx * -1) * rad2deg
    vv = atan2(sqrt(tx*tx + tz*tz), ty) * rad2deg

    // 牛顿迭代反解垂直角校正：v -= (v - B*sin(v*deg2rada) - vv) / (1 - deg2radab*cos(v*deg2rada))
    v = vv
    r1 = 3
    label invertVLoop:
    r0 = v - b * sin(v * deg2rada)
    r0 = r0 - vv
    r2 = 1 - deg2radab * cos(v * deg2rada)
    r0 = r0 / r2
    v = v - r0
    r1 = r1 - 1
    if r1 >= 0 { goto invertVLoop }

    put(db, 0, h)
    put(db, 1, v)
    db.Setting = 0
    goto wait
}
