// 交易求解器：根据三个参考点解算交易者坐标（可粘贴版本）。
//
// 原脚本：Trading/autoTrader/traderSolver.ic10
// 相比 solverLarge 多了垂直角校正：V = V - 6.88*sin(V*deg2rada)，
// 以及反向求解的牛顿迭代（invertVLoop）。
//
// 转换写成循环，每组的 X/Y/Z/E 依次写入宿主栈（4 个一组），
// 克拉默法则内联读取；共享的 2x2 子行列式只算一次。

const b = 6.88
const deg2rada = 0.0694117438141256949
const deg2radab = 0.477552797441184780912

func main() {
    var r0 = 0
    var r1 = 0
    var i = 0
    var h = 0
    var v = 0
    var e = 0
    var d = 0
    var a = 0
    var bb = 0
    var c = 0
    var tx = 0
    var ty = 0
    var tz = 0
    var vv = 0
    var iter = 0

    label wait:
    yield()
    if db.Setting == 0 { goto wait }

    // 3 组 HVE → X/Y/Z/E，写入宿主栈 100 起
    sp = 9
    i = 100
    label convert:
    e = pop()
    v = pop()
    h = pop()
    h = h * deg2rad
    v = v - b * sin(v * deg2rada)
    v = v * deg2rad
    put(db, i, -sin(v) * cos(h))
    i = i + 1
    put(db, i, cos(v))
    i = i + 1
    put(db, i, sin(v) * sin(h))
    i = i + 1
    put(db, i, cos(e * deg2rad))
    i = i + 1
    if sp != 0 { goto convert }

    // 2x2 子行列式（x0..z2 在 db 100/101/102、104/105/106、108/109/110）
    a = get(db, 105)*get(db, 110) - get(db, 106)*get(db, 109)  // Y1*Z2 - Z1*Y2
    bb = get(db, 104)*get(db, 110) - get(db, 106)*get(db, 108) // X1*Z2 - Z1*X2
    c = get(db, 104)*get(db, 109) - get(db, 105)*get(db, 108)  // X1*Y2 - Y1*X2
    d = get(db, 100)*a - get(db, 101)*bb + get(db, 102)*c

    // 克拉默法则（E0/E1/E2 在 db 103/107/111）
    tx = (a*get(db, 103) -
        (get(db, 101)*get(db, 110)-get(db, 102)*get(db, 109))*get(db, 107) +
        (get(db, 101)*get(db, 106)-get(db, 102)*get(db, 105))*get(db, 111)) / d
    ty = ((get(db, 100)*get(db, 110)-get(db, 102)*get(db, 108))*get(db, 107) -
        bb*get(db, 103) -
        (get(db, 100)*get(db, 106)-get(db, 102)*get(db, 104))*get(db, 111)) / d
    tz = (c*get(db, 103) -
        (get(db, 100)*get(db, 109)-get(db, 101)*get(db, 108))*get(db, 107) +
        (get(db, 100)*get(db, 105)-get(db, 101)*get(db, 104))*get(db, 111)) / d

    // 转回 HV（V 为未校正值）
    h = atan2(tz, tx * -1) * rad2deg
    vv = atan2(sqrt(tx*tx + tz*tz), ty) * rad2deg

    // 牛顿迭代反解垂直角校正
    v = vv
    iter = 3
    label invertVLoop:
    r0 = v - b * sin(v * deg2rada)
    r0 = r0 - vv
    r1 = 1 - deg2radab * cos(v * deg2rada)
    r0 = r0 / r1
    v = v - r0
    iter = iter - 1
    if iter >= 0 { goto invertVLoop }

    put(db, 0, h)
    put(db, 1, v)
    db.Setting = 0
    goto wait
}
