// 交易求解器（RAW）：原始未整理版本，数学与 traderSolver 相同
// （含垂直角校正与反向牛顿迭代）。
//
// 原脚本：Trading/autoTrader/traderSolverRAW.ic10
// 同 traderSolver：编译约 135 行，超过 128 行预算，保留为参考移植，
// 不参与端口等价测试（见 knownUnsupported）。

const b = 6.88
const deg2rada = 0.0694117438141256949
const deg2radab = 0.477552797441184780912

func main() {
    var r0 = 0
    var r1 = 0
    var i = 0
    var h = 0
    var v = 0
    var e = 0
    var d = 0
    var tx = 0
    var ty = 0
    var tz = 0
    var vv = 0
    var iter = 0

    label wait:
    yield()
    if db.Setting == 0 { goto wait }

    // 3 组 HVE → X/Y/Z/E，写入宿主栈 100 起
    sp = 9
    i = 100
    label convert:
    e = pop()
    v = pop()
    h = pop()
    h = h * deg2rad
    v = v - b * sin(v * deg2rada)
    v = v * deg2rad
    put(db, i, -sin(v) * cos(h))
    i = i + 1
    put(db, i, cos(v))
    i = i + 1
    put(db, i, sin(v) * sin(h))
    i = i + 1
    put(db, i, cos(e * deg2rad))
    i = i + 1
    if sp != 0 { goto convert }

    // 克拉默法则（子行列式内联，避免长活跃；x0..z2 在 db 100/101/102、
    // 104/105/106、108/109/110，E 在 103/107/111）
    d = get(db, 100)*(get(db, 105)*get(db, 110)-get(db, 106)*get(db, 109)) -
        get(db, 101)*(get(db, 104)*get(db, 110)-get(db, 106)*get(db, 108)) +
        get(db, 102)*(get(db, 104)*get(db, 109)-get(db, 105)*get(db, 108))

    tx = ((get(db, 105)*get(db, 110)-get(db, 106)*get(db, 109))*get(db, 103) -
        (get(db, 101)*get(db, 110)-get(db, 102)*get(db, 109))*get(db, 107) +
        (get(db, 101)*get(db, 106)-get(db, 102)*get(db, 105))*get(db, 111)) / d
    ty = ((get(db, 100)*get(db, 110)-get(db, 102)*get(db, 108))*get(db, 107) -
        (get(db, 104)*get(db, 110)-get(db, 106)*get(db, 108))*get(db, 103) -
        (get(db, 100)*get(db, 106)-get(db, 102)*get(db, 104))*get(db, 111)) / d
    tz = ((get(db, 104)*get(db, 109)-get(db, 105)*get(db, 108))*get(db, 103) -
        (get(db, 100)*get(db, 109)-get(db, 101)*get(db, 108))*get(db, 107) +
        (get(db, 100)*get(db, 105)-get(db, 101)*get(db, 104))*get(db, 111)) / d

    // 转回 HV（V 为未校正值）
    h = atan2(tz, tx * -1) * rad2deg
    vv = atan2(sqrt(tx*tx + tz*tz), ty) * rad2deg

    // 牛顿迭代反解垂直角校正
    v = vv
    iter = 3
    label invertVLoop:
    r0 = v - b * sin(v * deg2rada)
    r0 = r0 - vv
    r1 = 1 - deg2radab * cos(v * deg2rada)
    r0 = r0 / r1
    v = v - r0
    iter = iter - 1
    if iter >= 0 { goto invertVLoop }

    put(db, 0, h)
    put(db, 1, v)
    db.Setting = 0
    goto wait
}
