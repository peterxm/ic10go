// 交易求解器（大型）：把 3 组 HVE 观测转成 XYZ，用克拉默法则解出交易者
// 坐标，再转回水平/垂直角写回宿主内存。
//
// 原脚本：Trading/autoTraderLarge/solverLarge.ic10
// 宿主 Setting 置 1 表示请求求解；算完写 db[0]=H、db[1]=V 并把 Setting 清零。
//
// 注意：本端口按原脚本逐项计算，寄存器压力较大，编译约 145 行，超过 128 行
// 预算（原脚本用满 16 个寄存器 + 间接寄存器寻址）。保留为参考移植，
// 不参与端口等价测试（见 knownUnsupported）。

func main() {
    var r0 = 0
    var r1 = 0
    var x0 = 0
    var y0 = 0
    var z0 = 0
    var x1 = 0
    var y1 = 0
    var z1 = 0
    var x2 = 0
    var y2 = 0
    var z2 = 0
    var h = 0
    var v = 0
    var e = 0
    var d = 0
    var tx = 0
    var ty = 0
    var tz = 0

    label wait:
    yield()
    if db.Setting == 0 { goto wait }

    sp = 9

    // 第 1 组
    e = pop()
    v = pop()
    h = pop()
    h = h * deg2rad
    v = v * deg2rad
    x0 = -sin(v) * cos(h)
    y0 = cos(v)
    z0 = sin(v) * sin(h)
    put(db, 8, cos(e * deg2rad))

    // 第 2 组
    e = pop()
    v = pop()
    h = pop()
    h = h * deg2rad
    v = v * deg2rad
    x1 = -sin(v) * cos(h)
    y1 = cos(v)
    z1 = sin(v) * sin(h)
    put(db, 5, cos(e * deg2rad))

    // 第 3 组
    e = pop()
    v = pop()
    h = pop()
    h = h * deg2rad
    v = v * deg2rad
    x2 = -sin(v) * cos(h)
    y2 = cos(v)
    z2 = sin(v) * sin(h)
    put(db, 2, cos(e * deg2rad))

    // 行列式 d = X0*(Y1*Z2-Z1*Y2) - Y0*(X1*Z2-Z1*X2) + Z0*(X1*Y2-Y1*X2)
    r0 = x1 * z2
    r1 = z1 * x2
    r0 = r0 - r1
    d = y0 * r0
    r0 = x1 * y2
    r1 = y1 * x2
    r0 = r0 - r1
    r0 = z0 * r0
    d = r0 - d
    r0 = y1 * z2
    r1 = z1 * y2
    r1 = r0 - r1
    r0 = x0 * r1
    d = d + r0

    // tx = ((Y1*Z2-Z1*Y2)*E0 - (Y0*Z2-Z0*Y2)*E1 + (Y0*Z1-Z0*Y1)*E2) / d
    r0 = get(db, 8)
    tx = r1 * r0
    r0 = y0 * z2
    r1 = z0 * y2
    r0 = r0 - r1
    r1 = get(db, 5)
    r0 = r0 * r1
    tx = tx - r0
    r0 = y0 * z1
    r1 = z0 * y1
    r0 = r0 - r1
    r1 = get(db, 2)
    r0 = r0 * r1
    tx = tx + r0
    tx = tx / d

    // ty = ((X0*Z2-Z0*X2)*E1 - (X1*Z2-Z1*X2)*E0 - (X0*Z1-Z0*X1)*E2) / d
    r0 = x0 * z1
    r1 = z0 * x1
    ty = r0 - r1
    ty = ty * get(db, 2)
    r0 = x0 * z2
    r1 = z0 * x2
    r0 = r0 - r1
    r1 = get(db, 5)
    r0 = r0 * r1
    ty = r0 - ty
    r0 = x1 * z2
    r1 = z1 * x2
    r0 = r0 - r1
    r1 = get(db, 8)
    r0 = r0 * r1
    ty = ty - r0
    ty = ty / d

    // tz = ((X1*Y2-Y1*X2)*E0 - (X0*Y2-Y0*X2)*E1 + (X0*Y1-Y0*X1)*E2) / d
    r0 = x1 * y2
    r1 = y1 * x2
    tz = r0 - r1
    tz = tz * get(db, 8)
    r0 = x0 * y2
    r1 = y0 * x2
    r0 = r0 - r1
    r1 = get(db, 5)
    r0 = r0 * r1
    tz = tz - r0
    r0 = x0 * y1
    r1 = y0 * x1
    r0 = r0 - r1
    r1 = get(db, 2)
    r0 = r0 * r1
    tz = tz + r0
    tz = tz / d

    // 转回 HV
    h = atan2(tz, tx * -1) * rad2deg
    v = atan2(sqrt(tx*tx + tz*tz), ty) * rad2deg

    put(db, 0, h)
    put(db, 1, v)
    db.Setting = 0
    goto wait
}
