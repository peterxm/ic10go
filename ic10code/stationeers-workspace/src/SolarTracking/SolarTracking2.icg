// 太阳能板追踪（多板）：按传感器角度设置每块板的方向。
//
// 原脚本：SolarTracking/SolarTracking2.ic10
// 通过设备类型 hash + 名称 hash 批量控制；名称列表压入宿主栈后逐个处理。

const solarArrayHash = -2049226859
const solarSensorType = 1076425094
const solarSensorHash = hash("Solar Array 1 Solar Sensor")

func main() {
    for {
        sp = 0
        push(hash("Solar Array 1-1"))
        push(hash("Solar Array 1-2"))
        push(hash("Solar Array 1-3"))
        push(hash("Solar Array 1-4"))

        for sp > 0 {
            yield()
            panel := pop()

            db.Setting = batch.readName(solarArrayHash, panel, "Ratio", "Maximum")

            h := batch.readName(solarSensorType, solarSensorHash, "Horizontal", "Maximum") - 90
            batch.writeName(solarArrayHash, panel, "Horizontal", h)

            v := 90 - batch.readName(solarSensorType, solarSensorHash, "Vertical", "Maximum")
            batch.writeName(solarArrayHash, panel, "Vertical", v)
        }
    }
}
