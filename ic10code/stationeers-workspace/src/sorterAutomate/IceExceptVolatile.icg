// 分拣器编程：过滤 ItemNitrice / ItemOxite（Equals）。
//
// 原脚本：sorterAutomate/IceExceptVolatile.ic10
// 原脚本用 push/pop + sp 逐个写入分拣器栈地址，这里用 sorter.* 构建器直接写。

const sorter = d0

func main() {
    clr(sorter)
    sorter.Mode = 1
    put(sorter, 0, sorter.filterPrefabHash(hash("ItemNitrice")))
    put(sorter, 1, sorter.filterPrefabHash(hash("ItemOxite")))
}
