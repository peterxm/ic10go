// 自适应气闸（风暴版）：内外门/通风口状态机，支持高级（排气）与简易两种模式。
//
// 原脚本：Deprecated/Interior Airlocks/adaptiveAirlockStormEd/adaptiveAirlockStormEd.ic10
// 设备：d0/d1 = 内/外门、d2 = 进气口、d3 = 可选排气口、d4 = 压力传感器、d5 = 二极管。
// 动态设备端口：r13/r12 为门的编号，r11/r10 为真空/增压通风口编号，
// 用 readDev/writeDev 表达。

const interiorDoor = d0
const exteriorDoor = d1
const ventIn = d2
const ventOut = d3
const sensor = d4
const diode = d5

func main() {
    var r0 = 0
    var r1 = 0
    var r3 = 0
    var targetPressure = 0
    var currentPressure = 0
    var vacuumVent = 0
    var pressurizeVent = 0
    var closedDoor = 0
    var openedDoor = 0
    var internalPressure = 0
    var externalPressure = 0

    label beforeAll: // 复位设备
    interiorDoor.Mode = 1
    exteriorDoor.Mode = 1
    interiorDoor.Lock = 0
    exteriorDoor.Lock = 0
    ventIn.On = 0
    if isSet(ventOut) { ventOut.On = 0 } // 仅高级模式
    diode.On = 1
    internalPressure = 0
    externalPressure = 0
    yield()

    r0 = interiorDoor.Open
    r1 = exteriorDoor.Open
    if r0 == r1 { goto setup } // 只有一扇门开着
    openedDoor = logicalNor(r0, 0)
    closedDoor = r1 ^ 1
    if r0 != 0 { call stateInterior }
    if r1 != 0 { call stateExterior }

    label setup:
    interiorDoor.Open = 0
    exteriorDoor.Open = 1
    goto beforeAll

    label stateInterior:
    yield()
    call isAnyDoorActivated
    if r0 != 1 { goto transitionToExterior }
    goto stateInterior

    label stateExterior:
    yield()
    call isAnyDoorActivated
    if r0 != 1 { goto transitionToInterior }
    goto stateExterior

    label emergencyState:
    r0 = diode.On
    if r0 != 0 { goto beforeAll }
    interiorDoor.Mode = 0
    exteriorDoor.Mode = 0
    interiorDoor.Lock = 0
    exteriorDoor.Lock = 0
    yield()
    goto emergencyState

    label transitionToExterior:
    internalPressure = sensor.Pressure
    closedDoor = 0
    openedDoor = 1
    vacuumVent = 2
    pressurizeVent = 3
    targetPressure = max(externalPressure, 0.001)
    currentPressure = max(internalPressure, 0.001)
    call closeDoors
    call depressurize
    if isSet(ventOut) { call pressurize }
    call openDoors
    goto stateExterior

    label transitionToInterior:
    externalPressure = sensor.Pressure
    closedDoor = 1
    openedDoor = 0
    vacuumVent = 3
    pressurizeVent = 2
    targetPressure = max(internalPressure, 0.001)
    currentPressure = max(externalPressure, 0.001)
    call closeDoors
    if isSet(ventOut) { call depressurize }
    call pressurize
    call openDoors
    goto stateInterior

    label isAnyDoorActivated:
    r0 = db.Setting
    if r0 == 0 { goto L87 }
    db.Setting = 0
    label L87:
    ret

    label closeDoors:
    exteriorDoor.Lock = 1
    interiorDoor.Lock = 1
    writeDev(closedDoor, LogicType.Open, 0)
    label L92:
    r3 = readDev(closedDoor, LogicType.Open)
    if r3 != 0 { goto L92 }
    ret

    label openDoors:
    writeDev(openedDoor, LogicType.Open, 1)
    label L97:
    r0 = readDev(openedDoor, LogicType.Open)
    if r0 == 0 { goto L97 }
    exteriorDoor.Lock = 0
    interiorDoor.Lock = 0
    diode.Setting = 1
    ret

    label depressurize:
    writeDev(vacuumVent, LogicType.Mode, 1)
    writeDev(vacuumVent, LogicType.On, 1)
    label L106:
    r0 = diode.On
    if r0 == 0 { goto emergencyState }
    r0 = sensor.Pressure
    r1 = r0 / currentPressure
    diode.Setting = r1
    if r0 != 0 { goto L106 }
    writeDev(vacuumVent, LogicType.On, 0)
    ret

    label pressurize:
    writeDev(pressurizeVent, LogicType.Mode, 0)
    writeDev(pressurizeVent, LogicType.On, 1)
    label L117:
    r0 = diode.On
    if r0 == 0 { goto emergencyState }
    r0 = sensor.Pressure
    r1 = r0 / targetPressure
    diode.Setting = r1
    if r0 < targetPressure { goto L117 }
    writeDev(pressurizeVent, LogicType.On, 0)
    ret
}
