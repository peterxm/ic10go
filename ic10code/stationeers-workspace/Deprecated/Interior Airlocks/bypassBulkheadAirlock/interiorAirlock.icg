// 旁路气闸：两侧温压一致时像气闸一样工作，之后像舱壁门。
//
// 原脚本：Deprecated/Interior Airlocks/bypassBulkheadAirlock/interiorAirlock.ic10
// 设备：d0/d1 = 内/外门、d2/d3 = 内/外通风口、d4 = 传感器、d5 = LED。
// airlockmode = 内外环境是否一致（1 表示一致，可直接开门）。

const innerdoor = d0
const outerdoor = d1
const innervent = d2
const outervent = d3
const sensor = d4
const LED = d5

const pressureInner = 20
const pressureOuter = 20

func main() {
    var r0 = 0
    var r1 = 0
    var r2 = 0
    var airlockmode = 0

    outervent.Lock = 1
    innervent.Lock = 1
    outerdoor.Mode = 1
    innerdoor.Mode = 1

    if outerdoor.Open == 0 { goto openInner }

    label openOuter:
    innervent.On = 0
    outervent.On = 0
    innerdoor.Open = 0
    innerdoor.Setting = 0
    outerdoor.Open = 1
    outerdoor.Setting = 1

    label waitOuter:
    yield()
    call checkMode
    if outerdoor.Setting != innerdoor.Setting { goto waitOuter }
    outerdoor.Open = 0
    outerdoor.Setting = 0
    innerdoor.Setting = 0
    yield()
    yield()
    if airlockmode == 1 { goto openInner }

    outervent.Mode = 1
    outervent.On = 1
    LED.Color = 4

    label ventOuter:
    yield()
    if outerdoor.Setting != 0 { goto openOuter } // 中止
    if sensor.Pressure > 0 { goto ventOuter }
    outervent.On = 0
    innervent.Mode = 0
    innervent.On = 1

    label pressInner:
    yield()
    if innerdoor.Setting != 0 { goto openInner } // 跳过增压
    if sensor.Pressure < pressureInner { goto pressInner }

    label openInner:
    innervent.On = 0
    outervent.On = 0
    outerdoor.Open = 0
    outerdoor.Setting = 0
    innerdoor.Open = 1
    innerdoor.Setting = 1

    label waitInner:
    yield()
    call checkMode
    if outerdoor.Setting != innerdoor.Setting { goto waitInner }
    innerdoor.Open = 0
    innerdoor.Setting = 0
    outerdoor.Setting = 0
    yield()
    yield()
    if airlockmode == 1 { goto openOuter }

    innervent.Mode = 1
    innervent.On = 1
    LED.Color = 4

    label ventInner:
    yield()
    if innerdoor.Setting != 0 { goto openInner } // 中止
    if sensor.Pressure != 0 { goto ventInner }
    innervent.On = 0
    outervent.Mode = 0
    outervent.On = 1

    label pressOuter:
    yield()
    if outerdoor.Setting != 0 { goto openOuter } // 跳过增压
    if sensor.Pressure < pressureOuter { goto pressOuter }
    goto openOuter

    // 判断内外环境是否一致：压力/温度近似、挥发物/污染物比例低。
    label checkMode:
    r0 = sensor.Pressure
    r1 = batch.read(-1252983604, "Pressure", "Average")
    r2 = batch.read(-1252983604, "Pressure", "Minimum")
    airlockmode = r0 != r2
    airlockmode = airlockmode & approx(r0, r1, 0.15)
    r0 = sensor.Temperature
    r1 = batch.read(-1252983604, "Temperature", "Minimum")
    airlockmode = airlockmode & approx(r0, r1, 0.15)
    airlockmode = airlockmode & (batch.read(-1252983604, "RatioVolatiles", "Maximum") < 0.005)
    airlockmode = airlockmode & (batch.read(-1252983604, "RatioPollutant", "Maximum") < 0.005)
    db.Setting = airlockmode
    LED.Color = airlockmode * -3 + 5
    ret
}
