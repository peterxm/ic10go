// PFLE 压力罐：维持 DPLPA 压力，按燃料/氧化剂配比调节两台泵的设定值，
// 超压时把标准引擎当泄压阀使用（Engine.Setting=0, On=1）。
// d0=DPLPA, d1=FLPA, d2=OLPA, d3=PLPA, d4=燃料泵, d5=氧化剂泵。

const (
    engine  = 379750958 // Standard Engine
    maxPres = 6070
)

func main() {
    // 燃料:氧化剂 配比（本配方 1:2）
    vRatio := (1 / 17.2) / (2 / 38.5)

    for {
        // 打开各路 LPA / 泵 / 加压气体
        batch.write(-2113838091, "On", 1) // LPAs
        batch.write(435685051, "On", 1)   // GPA
        batch.write(-737232128, "On", 1)  // Purge
        batch.write(-737232128, "Setting", maxPres)
        batch.write(-321403609, "On", 1) // GasPump
        batch.write(23052817, "On", 1)   // Pressurant
        batch.write(23052817, "Setting", 5300)

        onState := batch.read(engine, "On", "Maximum")
        db.Setting = onState
        d4.On = onState
        d5.On = onState

        dpVol := d0.Volume
        totMol := d0.TotalMoles
        fdp := d0.RatioLiquidAlcohol + d0.RatioMethane
        odp := d0.RatioLiquidNitrousOxide + d0.RatioNitrousOxide

        // 燃料泵：按实际摩尔数与理想值的差修正体积
        fPump := dpVol * vRatio / (1 + vRatio) * 17.2
        fPump -= totMol * fdp * 1.1111
        d4.Setting = fPump / 17.2

        // 氧化剂泵
        oPump := dpVol / (1 + vRatio) * 38.5
        oPump -= totMol * odp * 1.1111
        d5.Setting = oPump / 38.5

        if d0.Pressure >= maxPres {
            overPres(onState)
        }
    }
}

// 超压处理：若引擎已开则跳过；否则反复启动引擎泄压，直到压力低于上限。
func overPres(onState num) {
    if onState != 0 { return }
    for {
        db.Setting = 3
        p := d0.Pressure
        batch.write(engine, "Setting", 0)
        batch.write(engine, "On", 1)
        if p < maxPres { break }
    }
    batch.write(engine, "On", 0)
    yield()
}
