alias In d0
s In Mode 1
alias Out d1
s Out Mode 1
alias GasSens d2
alias Gen d3
alias Lever d4

alias Pres r0
alias Temp r1
alias InTemp r2
alias OnState r3

Main:
l OnState Lever Setting
s Gen On OnState
l Pres GasSens Pressure
l Temp GasSens Temperature
ble Pres 25 LowPres
Main1:
bge Pres 100 HighPres
blt Pres 100 PresOK
Main2:
bge Temp 320 HighTemp
blt Temp 310 TempOK
Main3:
j Main

LowPres:
s In On 1
yield
s In On 0
j Main1

HighPres:
s Out On 1
j Main2

PresOK:
s Out On 0
j Main2

HighTemp:
s In On 1
j Main3

TempOK:
s In On 0
j Main3
