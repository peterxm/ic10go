// Vulcan - Automated Advanced Furnace port.
//
// Reads the ingot recipe from a logic dial, then keeps the furnace within the
// recipe's temperature/pressure window by pulsing a fuel (CH4/O2) or coolant
// (CO2) pump. The original "Confirm" button latches the controller into its
// running state.

const (
    furnace   = hash("StructureAdvancedFurnace")
    pump      = hash("StructureVolumePump")
    CH4O2Pump = hash("CH4O2 Pump")
    CO2Pump   = hash("CO2 Pump")
    dial      = hash("StructureLogicDial")
    IngotDial = hash("Ingot Dial")
    button    = hash("StructureLogicButton")
    buttonC   = hash("Confirm")
)

func main() {
    var state = 0

    for {
        yield()
        state = 0
        db.Setting = state

        recipe := batch.readName(dial, IngotDial, "Setting", "Sum")
        isConfirmed := batch.readName(button, buttonC, "Setting", "Sum")

        if isConfirmed == 1 {
            state = 1
            db.Setting = state
        }
        if state == 1 {
            control(recipe)
        }
    }
}

// control drives the furnace forever once the recipe has been confirmed.
func control(recipe num) {
    // 0..7 are the base metals; only they set a control window.
    var minT = 0
    var maxT = 0
    var minP = 0
    if recipe <= 7 {
        minT = 950
        maxT = 100000
        minP = 1000
    }

    for {
        temp := batch.read(furnace, "Temperature", "Sum")
        press := batch.read(furnace, "Pressure", "Sum")
        if temp < minT || press < minP {
            addFuel()
        } else if temp > maxT {
            addCoolant()
        }
    }
}

func addFuel() {
    batch.writeName(pump, CH4O2Pump, "Setting", 10)
    batch.write(furnace, "SettingInput", 10)
    sleep(1)
    batch.writeName(pump, CH4O2Pump, "Setting", 0)
    batch.write(furnace, "SettingInput", 0)
}

func addCoolant() {
    batch.writeName(pump, CO2Pump, "Setting", 10)
    batch.write(furnace, "SettingInput", 10)
    sleep(1)
    batch.writeName(pump, CO2Pump, "Setting", 0)
    batch.write(furnace, "SettingInput", 0)
}
