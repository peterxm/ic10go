// 生存腰带：受伤（HealthDamage >= 75）时激活医疗针，眩晕（EntityState == 2）时激活兴奋剂，
// 并发出声音警报；正常时清除警报。

func main() {
    for {
        e := db.EntityState
        if e == 0 {
            db.SoundAlert = 0 // 一切正常
        } else {
            if db.HealthDamage >= 75 {
                if isSet(d3) { d3.Activate = 1 } // 医疗针
                db.SoundAlert = 1
            }
            if e == 2 {
                if isSet(d2) { d2.Activate = 1 } // 兴奋剂
                db.SoundAlert = 1
            }
        }
    }
}
