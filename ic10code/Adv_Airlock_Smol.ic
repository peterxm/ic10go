define pressureIn 100
define pressureEx 0
alias doorEx d0
alias ventEx d1
alias ventIn d2
alias doorIn d3
alias sensor d4

alias state r0
alias inVentMode r1
alias pressure r2
alias doorTriggered r12
alias logicType r13
alias device r14
alias temp r15
poke 0 LogicType.Open
poke 1 LogicType.On
poke 2 LogicType.On
poke 3 LogicType.Open
poke 4 LogicType.Setting
poke 7 LogicType.Setting

main:
	yield
	l inVentMode ventIn Mode
	l pressure sensor Pressure
	move sp 8           # Load values from stack
	pop logicType
	breqz logicType 4
	mod temp sp 4
	l temp dr15 logicType
	ins state temp sp 1
	brgtz sp -5
	srl temp state 4    # Determine door trigger state, Setting vs Open
	xor temp temp state
	and doorTriggered temp 9
	and state state 15

	loop:
		and temp state 8                            # Close Ex door if both doors are open
		select temp temp 14 15
		and state state temp
		beqz state main                             # Validate our state; exactly one active bit is required or we wait
		sub temp state 1
		and temp temp state
		bnez temp main

		and temp state 9                            # If any doors are open...
		srl device state 3
		select inVentMode temp device inVentMode    # Set vent mode(s)
		bnez doorTriggered trigger
		bnez temp end                               # And skip pressure checks

		sll temp 2 inVentMode                       # Pressure checks
		brne state temp 2
		beqz pressure trigger
		beq state temp end
		select temp inVentMode pressureEx pressureIn
		bge pressure temp trigger

		end:
		ins state state 4 4    # Copy current phase nibble into Setting nibble for bits 4/7
		s doorEx Mode 1
		s doorIn Mode 1
		s ventIn Mode inVentMode
		seqz temp inVentMode
		s ventEx Mode temp
		move sp 8              # Iterate stack to write
		pop logicType
		breqz logicType 5
		mod device sp 4
		srl temp state sp
		and temp temp 1
		s dr14 logicType temp
		brgtz sp -6
	j main

	trigger:                                 # Shifts the active value around
	move doorTriggered 0            # IN -> EX: 1000 -> 0100 -> 0010 -> 0001
	select temp inVentMode 0.5 2    # EX -> IN: 0001 -> 0010 -> 0100 -> 1000
	mul state state temp
j loop                          # And loop in case we meet further conditions