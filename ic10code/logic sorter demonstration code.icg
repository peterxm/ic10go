// 逻辑分拣器（Logic Sorter）演示：向分拣器内部栈写入 4 条过滤指令。
//
// 指令编码：低 8 位为 OP 码，高位为参数。
//   FilterPrefabHash：    [物品哈希] << 8  | OP
//   FilterSlotType：      [SlotClass] << 16 | OP
//   FilterSortingClass：  [SortingClass] << 16 | OP
//
// 说明：SorterInstruction / SlotClass / SortingClass 是游戏内枚举，
// 具体数值以 Stationpedia 为准。此处 FilterPrefabHashEquals 取参考文档的 1，
// 其余为常见取值，移植到实际存档前请按游戏版本核对。

const (
    opFilterPrefabHashEquals    = 1 // SorterInstruction.FilterPrefabHashEquals
    opFilterSlotTypeCompare     = 3 // SorterInstruction.FilterSlotTypeCompare
    opFilterSortingClassCompare = 4 // SorterInstruction.FilterSortingClassCompare

    slotClassBattery = 1 // SlotClass.Battery
    sortingClassOres = 1 // SortingClass.Ores
)

func main() {
    d0.Mode = 2 // Any：任一过滤指令匹配即输出

    // 过滤 Road Flare（ItemRoadFlare = 871811564）
    put(d0, 0, hash("ItemRoadFlare")<<8 | opFilterPrefabHashEquals)
    // 过滤 Kit(Insulated Tank)（ItemKitTankInsulated = 1021053608）
    put(d0, 1, hash("ItemKitTankInsulated")<<8 | opFilterPrefabHashEquals)
    // 过滤电池槽位
    put(d0, 2, slotClassBattery<<16 | opFilterSlotTypeCompare)
    // 过滤矿石分类
    put(d0, 3, sortingClassOres<<16 | opFilterSortingClassCompare)
}
