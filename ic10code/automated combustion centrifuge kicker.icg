// 自动燃烧离心机启动器：当离心机停机时，先泄压（Throttle/CombustionLimiter 归零），
// 等 Rpm 与 Stress 都回零后再点火启动；两台离心机依次处理。

func main() {
    for {
        if d0.On == 0 {
            turnOnCC1()
        } else if d1.On == 0 {
            turnOnCC2()
        } else {
            db.Setting = 0 // 调试指示灯：全部运行中
        }
    }
}

// 启动 1 号离心机：循环归零并等待其完全停稳，然后点火。
func turnOnCC1() {
    for {
        db.Setting = 1
        d0.Throttle = 0
        d0.CombustionLimiter = 0
        if d0.Rpm <= 0 && d0.Stress <= 0 { break }
    }
    d0.On = 1
}

// 启动 2 号离心机。
func turnOnCC2() {
    for {
        db.Setting = 2
        d1.Throttle = 0
        d1.CombustionLimiter = 0
        if d1.Rpm <= 0 && d1.Stress <= 0 { break }
    }
    d1.On = 1
}
