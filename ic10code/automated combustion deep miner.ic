alias CDM db
alias LED1 d0 #Delete this row if you dont want a screen output
alias progress r0 #read
alias stress r1 #read
alias slerpm r3 #read
alias sgethrottle r4 #read
alias rpm r5 #read
alias throttle r6 #read
alias bigbad r7

Init:
l stress CDM Stress
bgt stress 10 Init
Start10:
s CDM Open 1
s CDM Throttle 10
l stress CDM Stress
blt stress 40 Start10
Start0:
s CDM Throttle 0
l stress CDM Stress
l progress CDM ExportCount #Delete this row if you dont want a screen output
s LED1 Setting progress #Delete this row if you dont want a screen output
bgt stress 30 Start0
Startrpm:
s CDM Throttle 10
l stress CDM Stress
l progress CDM ExportCount #Delete this row if you dont want a screen output
s LED1 Setting progress #Delete this row if you dont want a screen output
bgt stress 20 Startrpm
Start50:
s CDM Throttle 50
l rpm CDM Rpm
l progress CDM ExportCount #Delete this row if you dont want a screen output
s LED1 Setting progress #Delete this row if you dont want a screen output
blt rpm 350 Start50
StartFull:
s CDM Throttle 100
s CDM CombustionLimiter 30

Operation:
#Emergency Power Loss Logic
l rpm CDM Rpm
l throttle CDM Throttle
sge sgethrottle throttle 20
sle slerpm rpm 100
and bigbad sgethrottle slerpm
beq bigbad 1 Emergency
l progress CDM ExportCount #Delete this row if you dont want a screen output
s LED1 Setting progress #Delete this row if you dont want a screen output
j Operation

Emergency:
s CDM Throttle 0
s CDM CombustionLimiter 0
l stress CDM Stress
bgt stress 10 Emergency
j Init
