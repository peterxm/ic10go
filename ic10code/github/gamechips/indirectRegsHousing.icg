// 游戏内社区服务器存档里的真实脚本（芯片名：StructureCircuitHousing）。
// 由 `ic10c decompile -s` 反编译后整理为端口，行为与原脚本一致。
// icg: shared-stack
func main() {
    var r0 = 0
    var r1 = 0
    var r2 = 0
    var r3 = 0
    var r4 = 0
    var r5 = 0
    var r6 = 0
    var r7 = 0
    var r8 = 0
    var r9 = 0
    var r10 = 0
    var r11 = 0
    r0 = hash("StructureSolarPanel")
    r1 = hash("StructureSolarPanelDual")
    r2 = hash("StructureSolarPanelReinforced")
    r3 = hash("StructureSolarPanelDualReinforced")
    label reset:
    r8 = 999
    r10 = 0
    r11 = 0
    for {
        label L19:
        r5 = d0.Vertical
        if r5 < 20 { goto reset }
        if r5 >= 75 { goto reset }
        r5 = (90 - r5)
        d1.Vertical = r5
        r5 = round(r5)
        r9 = d1.Vertical
        r9 = round(r9)
        if r9 != r5 { goto L19 }
        label L28:
        r6 = d0.Horizontal
        r6 = (r6 + r11)
        if r6 < 0 {
            r6 = (r6 + 360)
        }
        if r6 > 360 {
            r6 = (r6 - 360)
        }
        d1.Horizontal = r6
        r6 = round(r6)
        r9 = d1.Horizontal
        r9 = round(r9)
        if r9 != r6 { goto L28 }
        r9 = d1.Ratio
        if r9 > r10 {
            r10 = r9
            r7 = r11
            db.Setting = r7
        }
        r11 = (r11 + 90)
        if r11 == 360 { break }
    }
    label start:
    r5 = d0.Vertical
    if r5 < 90 { goto solar_angle }
    if r8 == 999 {
        if r5 < 91 {
            r10 = r5
            yield()
            r5 = d0.Vertical
            r10 = (r10 - r5)
            if r10 > 0 {
                r8 = d0.Horizontal
                r8 = (r8 + r7)
            }
        }
    }
    r5 = 15
    r6 = r8
    goto loop
    label solar_angle:
    r5 = (90 - r5)
    r6 = d0.Horizontal
    r6 = (r6 + r7)
    for {
        label loop:
        if r4 != 4 { goto L70 }
        r4 = 0
        goto start
        label L70:
        batch.write(ireg(r4), "Horizontal", r6)
        batch.write(ireg(r4), "Vertical", r5)
        r4 = (r4 + 1)
    }
}
