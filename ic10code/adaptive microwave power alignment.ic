alias PowerTransmitter d0
alias LogicTransmitter d1
#Logic Transmitter must be linked to the Microwave Power Receiver

alias deltaX r13
alias deltaZ r14
alias deltaY r15
define pi 3.1415
define DegFromNorth 90 #Enter azimuth reading facing away from data port

main:
yield
l r0 LogicTransmitter PositionX
l r1 PowerTransmitter PositionX
sub deltaX r0 r1
l r0 LogicTransmitter PositionZ
l r1 PowerTransmitter PositionZ
sub deltaZ r0 r1
l r0 LogicTransmitter PositionY
l r1 PowerTransmitter PositionY
sub deltaY r0 r1
atan2 r0 deltaX deltaZ
mul r0 r0 180
div r0 r0 pi
sub r0 r0 90
sub r0 r0 DegFromNorth #Corrects for non-north-pointing data port
s PowerTransmitter Horizontal r0
add r0 180 r0
s LogicTransmitter Horizontal r0
mul r0 deltaX deltaX
mul r1 deltaZ deltaZ
add r0 r0 r1
sqrt r0 r0
div r0 deltaY r0
atan r0 r0
mul r0 r0 180
div r0 r0 pi
add r0 r0 90
s PowerTransmitter Vertical r0
sub r0 180 r0
s LogicTransmitter Vertical r0
j main
