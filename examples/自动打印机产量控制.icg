// 打印机产量控制器（表驱动高效版）。
//
// 原脚本：游戏内芯片 "IC HAuto-Craft"（74 行，作者 CowsAreEvil）。
// 功能：多台「打印机 + 堆叠机」配对，在堆叠机 Setting 上设定目标数量；
//       打印机在打印时按 ExportCount 增量统计，到量即清除 Activate 停机；
//       空闲时刷新基线并把打印机 On 镜像给堆叠机。
//
// 相对原版的改动（更短、可扩展）：
//   - 打印机预制体 / 堆叠机 NameHash 放进 data 表，由一次性 loader 安装；
//   - 运行时 for range 遍历，加一台打印机只需往两张表各加一行；
//   - 产量基线放在芯片持久栈 db.stack[i]（绝对槽，不用手工 push/pop/sp）。
//
// 部署：先运行一次 loader（<file>.data.ic），再运行 runtime。

data Printers = [
    hash("StructureAutolathe"),
    hash("StructureElectronicsPrinter"),
    hash("StructureHydraulicPipeBender"),
    hash("StructureRocketManufactory"),
    hash("StructureToolManufactory"),
    hash("StructureSecurityPrinter"),
]

data Stackers = [
    hash("Autolathe Stacker"),
    hash("Electronics Stacker"),
    hash("Pipe Stacker"),
    hash("Rocket Stacker"),
    hash("Tool Stacker"),
    hash("Security Stacker"),
]

const Stacker = hash("StructureStackerReverse")

func main() {
    for {
        yield()
        for i, printer := range Printers {
            pa := batch.read(printer, "ReferenceId", "Average")
            st := batch.readName(Stacker, Stackers[i], "ReferenceId", "Average")
            if isNaN(pa) || isNaN(st) {
                continue
            }
            if readById(pa, LogicType.Activate) != 0 {
                if readById(pa, LogicType.ExportCount)-db.stack[i] >= readById(st, LogicType.Setting) {
                    writeById(pa, LogicType.Activate, 0)
                }
            } else {
                db.stack[i] = readById(pa, LogicType.ExportCount)
                writeById(st, LogicType.On, readById(pa, LogicType.On))
            }
        }
    }
}
