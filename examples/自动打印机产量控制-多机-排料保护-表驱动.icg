// 打印机产量控制器（多机 · 按名字配对 · 表驱动 loader 版）。
//
// 逻辑简单，重点在 tick 控制（IC 每 tick 只有 128 条，9 台一轮塞不下）：
//   * 每台 ReferenceId 只在加载后第一 tick 解析一次并缓存 → 之后每 tick 0 次 lbn。
//   * 每 tick 跑一遍 fastStep（开口 + 到量停机，最关键、要及时），约 9 台 ~70 条。
//   * 每 tick 只跑 1 台的 slowStep（空闲后的零头/吐料/On），用游标轮转，9 tick 转完一轮。
//   这样每轮循环 ~110 条，能压在 1 tick 内，fastStep 才真的“每 tick”。
//
// 功能：
//   * 正常打印：产量到 Setting 停打印机；堆垛机按 Setting 自动吐整摞。Setting 超物品
//     堆叠上限（MaxQuantity）时自动吐只吐满的，零头用 Activate=1 顶出来。
//   * 开口排料（Open=1）：持续 Activate=1 来一个吐一个（不攒，防多材料堵死）；打印机
//     Reagents=0 后 IC 收杆。
//
// 部署：ic10c build 生成 <file>.data.ic，先跑一次 loader，再烧 runtime。
//
// 持久栈布局（用户区，每台 4 个槽，i*4）：[产量基线, 吐料标志, 打印机 id, 堆垛机 id]
//   CUR / BOOT：slowStep 游标与首 tick 标记，放在最顶（125 / 127）
// 加机器：Units 追加 3 个值、COUNT 加一；i*4 别碰到 CUR(125) 即可（约 ≤31 台）。
const Stacker = hash("StructureStackerReverse")

const CUR = 125  // slowStep 轮转游标
const BOOT = 127  // 首 tick 标记 / 解析 ReferenceId 的开关
const CFG = 3  // 每台配置 3 个值
const ST = 4  // 每台状态 4 个槽

data Units = [
    // 打印机类型 / 打印机名 / 堆叠机名
    hash("StructureAutolathe"),
    hash("Autolathe A"),
    hash("Autolathe Stacker A"),
    hash("StructureAutolathe"),
    hash("Autolathe B"),
    hash("Autolathe Stacker B"),
    hash("StructureElectronicsPrinter"),
    hash("Electronics A"),
    hash("Electronics Stacker A"),
    hash("StructureElectronicsPrinter"),
    hash("Electronics B"),
    hash("Electronics Stacker B"),
    hash("StructureHydraulicPipeBender"),
    hash("Pipe Bender A"),
    hash("Pipe Stacker A"),
    hash("StructureHydraulicPipeBender"),
    hash("Pipe Bender B"),
    hash("Pipe Stacker B"),
    hash("StructureRocketManufactory"),
    hash("Rocket"),
    hash("Rocket Stacker"),
    hash("StructureToolManufactory"),
    hash("Tool"),
    hash("Tool Stacker"),
]

// 加机器：Units 追加 3 个值即可，COUNT 由表长自动算出（len(Units)/CFG）。
const COUNT = len(Units) / CFG  // 打印机台数（= 表长 / 每台 3 个值）

func main() {
    db.stack[BOOT] = 1
    db.stack[CUR] = 0
    for {
        yield()
        if db.stack[BOOT] != 0 {
            for i := 0; i < COUNT; i++ {
                resolve(i)
            }
        }
        // 每 tick：开口 + 到量停机（最要紧）
        for i := 0; i < COUNT; i++ {
            fastStep(i)
        }
        // 每 tick 只做 1 台的空闲/吐料逻辑，游标轮转
        slowStep(db.stack[CUR])
        db.stack[CUR]++
        if db.stack[CUR] >= COUNT {
            db.stack[CUR] = 0
        }
        db.stack[BOOT] = 0
    }
}

// resolve：首 tick 解析并缓存 ReferenceId。
func resolve(i num) {
    cfg := i * CFG
    base := i * ST
    db.stack[base + 2] = batch.readName(Units[cfg], Units[cfg + 1], "ReferenceId", "Average")
    db.stack[base + 3] = batch.readName(Stacker, Units[cfg + 2], "ReferenceId", "Average")
}

// fastStep：开口排料 + 到量停打印机（每 tick 跑）。
func fastStep(i num) {
    base := i * ST
    pa := db.stack[base + 2]
    st := db.stack[base + 3]
    if isNaN(pa) || isNaN(st) {
        return
    }
    if readById(pa, LogicType.Open) != 0 {
        // 开口：持续强制排（Activate 无视数量），不攒，避免多种材料塞死
        db.stack[base + 1] = 1
        writeById(st, LogicType.Mode, 1)
        writeById(st, LogicType.Activate, 1)
        if readById(pa, LogicType.Reagents) == 0 {
            writeById(pa, LogicType.Open, 0)  // 排空了，IC 收杆
        }
    } else if readById(pa, LogicType.Activate) != 0 && readById(pa, LogicType.ExportCount) - db.stack[base] >= readById(st, LogicType.Setting) {
        writeById(pa, LogicType.Activate, 0)  // 到量立即停
    }
}

// slowStep：空闲后的零头/吐料/On 镜像（每 tick 只处理 1 台）。
func slowStep(i num) {
    base := i * ST
    pa := db.stack[base + 2]
    st := db.stack[base + 3]
    if isNaN(pa) || isNaN(st) {
        return
    }
    if readById(pa, LogicType.Open) != 0 || readById(pa, LogicType.Activate) != 0 {
        return  // 开口/打印中交给 fastStep
    }
    done := readById(pa, LogicType.ExportCount) - db.stack[base]
    // Setting 超过物品堆叠上限时，自动吐只吐满的，零头用 Activate 顶出来
    maxq := readByIdSlot(st, 2, MaxQuantity)
    setting := readById(st, LogicType.Setting)
    if done >= setting && maxq > 0 && setting > maxq {
        db.stack[base + 1] = 1
    }
    // 内部槽里是锭：直接排出，不做其它处理（锭不该被留着/切）
    if readByIdSlot(st, 2, Class) == SlotClass.Ingot {
        db.stack[base + 1] = 1
    }
    db.stack[base] += done
    writeById(st, LogicType.On, readById(pa, LogicType.On))
    // 正在吐：堆垛机内部槽空了就停
    if db.stack[base + 1] != 0 && readByIdSlot(st, 2, Occupied) == 0 {
        db.stack[base + 1] = 0
    }
    if db.stack[base + 1] != 0 {
        writeById(st, LogicType.Mode, 1)
    } else {
        writeById(st, LogicType.Mode, 0)
    }
    writeById(st, LogicType.Activate, db.stack[base + 1])
}
