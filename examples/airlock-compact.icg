// 气闸控制（紧凑版）：与 airlock.icg 逻辑相同，但用 const hash + 每气闸三元选择
// 取代 data 表，因此不需要持久栈数据段和一次性 loader。
// 6 个设备引用在 step 顶部只加载一次，idle / depressurize / pressurize 共用。
const (
    AIRLOCKS = 2
    IDLE = 0
    DEPRESSURIZE = 1
    PRESSURIZE = 2

    TargetIn = 50
    TargetOut = 0

    Door = -793837322
    ActiveVent = -1129453144
    FlashingLight = 797794350
    GasSensor = -1252983604

    DoorIn0 = hash("Power Station")
    DoorIn1 = hash("DoorInEast")
    DoorOut0 = hash("Airlock West")
    DoorOut1 = hash("DoorOutEast")
    VentIn0 = hash("VentInWest")
    VentIn1 = hash("VentInEast")
    VentOut0 = hash("VentOutWest")
    VentOut1 = hash("VentOutEast")
    Light0 = hash("LightWest")
    Light1 = hash("LightEast")
    Sensor0 = hash("SensorWest")
    Sensor1 = hash("SensorEast")
)

func main() {
    for {
        yield()
        for i := 0; i < AIRLOCKS; i++ {
            step(i)
        }
    }
}

func step(i num) {
    doorIn := i == 0 ? DoorIn0 : DoorIn1
    doorOut := i == 0 ? DoorOut0 : DoorOut1
    state := get(db, i)
    if state == IDLE {
        if batch.readName(Door, doorIn, "Setting", "Maximum") != batch.readName(Door, doorOut, "Setting", "Maximum") {
            return
        }
        out := batch.readName(Door, doorIn, "Open", "Maximum") != 0
        put(db, AIRLOCKS + i, out ? 0 : 1)
        put(db, i, DEPRESSURIZE)
        return
    }
    ventIn := i == 0 ? VentIn0 : VentIn1
    ventOut := i == 0 ? VentOut0 : VentOut1
    dir := get(db, AIRLOCKS + i)
    closeDoor := dir == 0 ? doorIn : doorOut
    openDoor := dir == 0 ? doorOut : doorIn
    closeVent := dir == 0 ? ventIn : ventOut
    openVent := dir == 0 ? ventOut : ventIn
    target := dir == 0 ? TargetOut : TargetIn
    light := i == 0 ? Light0 : Light1
    sensor := i == 0 ? Sensor0 : Sensor1
    if state == DEPRESSURIZE {
        batch.writeName(Door, closeDoor, "Open", 0)
        batch.writeName(ActiveVent, closeVent, "Mode", 1)
        batch.writeName(ActiveVent, closeVent, "On", 1)
        batch.writeName(FlashingLight, light, "On", 1)
        if batch.readName(GasSensor, sensor, "Pressure", "Maximum") != 0 {
            return
        }
        batch.writeName(ActiveVent, closeVent, "On", 0)
        if target == TargetOut {
            batch.writeName(Door, openDoor, "Open", 1)
            batch.writeName(FlashingLight, light, "On", 0)
            put(db, i, IDLE)
        } else {
            batch.writeName(ActiveVent, openVent, "Mode", 0)
            batch.writeName(ActiveVent, openVent, "On", 1)
            put(db, i, PRESSURIZE)
        }
        return
    }
    if batch.readName(GasSensor, sensor, "Pressure", "Maximum") >= target {
        batch.writeName(Door, openDoor, "Open", 1)
        batch.writeName(ActiveVent, openVent, "On", 0)
        batch.writeName(FlashingLight, light, "On", 0)
        put(db, i, IDLE)
    }
}
