// 打印机产量控制器（多机 · 表驱动 loader 版 · 3 字段）。
//
// 与 examples/自动打印机产量控制-多机表驱动-4字段.icg 控制相同的 9 台机器
// （同型号多台、同名），同样用 data 表 + for 遍历，代码行数不随台数增长。
// 唯一区别：省掉「基线槽位」这一列，基线直接用遍历下标 db.stack[i]。
// 代价是要先跑一次 loader（编译自动生成的 <file>.data.ic）再烧 runtime。
//
// 每台打印机占连续 3 个槽：打印机类型、打印机名、堆叠机名。
// 同型号多台靠名字区分。基线槽位 = 该台在 Units 里的下标 i（0,1,2,...），
// 所以不需要手写、也不会写重；但要保证下标不超过用户栈区 0..127。
// 加一台打印机：在 Units 末尾追加 3 个值，并把 COUNT 加一。
//
// 上限：默认 128 用户栈槽 [0..127] 时数据段 384 槽，每台 3 槽，最多
//   (384-1)/3 = 127 台（基线下标 0..126 正落在用户区内）。
//   加 `--user-stack <台数>` 也还是 127 台——这已是 512 个栈槽、每台
//   4 槽（3 数据 + 1 基线）的总上限，本版到顶，无需再调参。
//   ⚠ 基线索引 db.stack[i] 是运行时变量，编译器不检查越界，所以
//     --user-stack 必须 ≥ 台数，否则基线会压进数据段、运行时坏数据；
//     也不要图省事用 --dynamic-stack（它会把数据紧贴用户区下方，静默重叠）。
// 4 字段版默认 95 台（加 --user-stack 可到 102），基线槽位可任意指定、
//   方便和直接调用版逐槽对齐。
const Stacker = hash("StructureStackerReverse")

data Units = [
    // 打印机类型 / 打印机名 / 堆叠机名
    hash("StructureAutolathe"),
    hash("Autolathe A"),
    hash("Autolathe Stacker A"),
    hash("StructureAutolathe"),
    hash("Autolathe B"),
    hash("Autolathe Stacker B"),
    hash("StructureElectronicsPrinter"),
    hash("Electronics A"),
    hash("Electronics Stacker A"),
    hash("StructureElectronicsPrinter"),
    hash("Electronics B"),
    hash("Electronics Stacker B"),
    hash("StructureHydraulicPipeBender"),
    hash("Pipe Bender A"),
    hash("Pipe Stacker A"),
    hash("StructureHydraulicPipeBender"),
    hash("Pipe Bender B"),
    hash("Pipe Stacker B"),
    hash("StructureRocketManufactory"),
    hash("Rocket"),
    hash("Rocket Stacker"),
    hash("StructureToolManufactory"),
    hash("Tool"),
    hash("Tool Stacker"),
    hash("StructureSecurityPrinter"),
    hash("Security"),
    hash("Security Stacker"),
]

const COUNT = 9  // 打印机台数
const STRIDE = 3  // 每台占的槽数

func main() {
    for {
        yield()
        for i := 0; i < COUNT; i++ {
            control(i)
        }
    }
}

// control 处理第 i 台：从 Units 里取类型 / 名字，按名字配对 ReferenceId，
// 到量停机；空闲时刷新产量基线并镜像 On。基线存在持久栈 db.stack[i]。
func control(i num) {
    base := i * STRIDE
    pa := batch.readName(Units[base], Units[base + 1], "ReferenceId", "Average")
    st := batch.readName(Stacker, Units[base + 2], "ReferenceId", "Average")
    if isNaN(pa) || isNaN(st) {
        return
    }
    if readById(pa, LogicType.Activate) != 0 {
        if readById(pa, LogicType.ExportCount) - db.stack[i] >= readById(st, LogicType.Setting) {
            writeById(pa, LogicType.Activate, 0)
        }
    } else {
        db.stack[i] = readById(pa, LogicType.ExportCount)
        writeById(st, LogicType.On, readById(pa, LogicType.On))
    }
}
