// 打印机产量控制器（多机 · 打印机栈版）。
//
// 与多机字段版的区别：打印交给打印机自己的「栈程序」，IC 只负责按用户触发装载/清除：
//   触发（打印机 Activate != 0）首次：写栈程序并启动
//     槽 0  : printer.waitUntilNextValid()   缺料就等
//     槽 1  : printer.executeRecipe(QTY, 打印机当前配方)
//     槽 63 : printer.stackPointer(0)
//   到量（ExportCount 增量 >= 堆垛机 Setting）或用户中途松手（Activate == 0）：
//     清栈（写 no-op）并 Activate = 0 —— 打印机空闲会循环遍历栈，装了不撤会一直重打。
//
// 栈布局（打印机栈 64 槽）：0..53 指令，54..62 缺失反应物，63 StackPointer。
// 指令位段见 printer.* 构建器（低 8 位 OP + 参数）。
//
// 按名字配对多台同类打印机（A/B 区分）：
//   打印机：prefab + 打印机名（batch.readName）
//   堆垛机：StructureStackerReverse + 堆垛机名（batch.readName）
// 加一组：Units 追加 3 个值即可，COUNT 自动算出。
// 部署：先跑一次 loader（<file>.data.ic），再烧 runtime。
const Stacker = hash("StructureStackerReverse")
const QTY = 50  // 每轮打印数量

const CUR = 125   // slowStep 轮转游标
const BOOT = 127  // 首 tick：解析 ReferenceId
const INST = 64   // 每台「已装栈」标志：db.stack[INST + i]
const CFG = 3     // 打印机类型 / 打印机名 / 堆垛机名
const ST = 4      // [触发基线, 吐料标志, 打印机 id, 堆垛机 id]

data Units = [
    hash("StructureAutolathe"), hash("Autolathe A"), hash("Autolathe Stacker A"),
    hash("StructureAutolathe"), hash("Autolathe B"), hash("Autolathe Stacker B"),
    hash("StructureElectronicsPrinter"), hash("Electronics A"), hash("Electronics Stacker A"),
    hash("StructureElectronicsPrinter"), hash("Electronics B"), hash("Electronics Stacker B"),
    hash("StructureHydraulicPipeBender"), hash("Pipe Bender A"), hash("Pipe Stacker A"),
    hash("StructureHydraulicPipeBender"), hash("Pipe Bender B"), hash("Pipe Stacker B"),
    hash("StructureRocketManufactory"), hash("Rocket"), hash("Rocket Stacker"),
    hash("StructureToolManufactory"), hash("Tool"), hash("Tool Stacker"),
]

const COUNT = len(Units) / CFG

func main() {
    db.stack[BOOT] = 1
    db.stack[CUR] = 0
    for {
        yield()
        if db.stack[BOOT] != 0 {
            for i := 0; i < COUNT; i++ {
                resolve(i)
                db.stack[INST + i] = 0
            }
        }
        // 每 tick：触发/到量/缺料（每台）
        for i := 0; i < COUNT; i++ {
            fastStep(i)
        }
        // 每 tick：1 台的堆垛机排料，游标轮转
        slowStep(db.stack[CUR])
        db.stack[CUR]++
        if db.stack[CUR] >= COUNT {
            db.stack[CUR] = 0
        }
        db.stack[BOOT] = 0
    }
}

// resolve：首 tick 解析并缓存 ReferenceId（按名字区分 A/B）。
func resolve(i num) {
    cfg := i * CFG
    base := i * ST
    db.stack[base + 2] = batch.readName(Units[cfg], Units[cfg + 1], "ReferenceId", "Average")
    db.stack[base + 3] = batch.readName(Stacker, Units[cfg + 2], "ReferenceId", "Average")
}

// fastStep：用户触发才装栈打印；到量/松手清栈停机；缺料排出缺失反应物。
func fastStep(i num) {
    base := i * ST
    pa := db.stack[base + 2]
    st := db.stack[base + 3]
    if isNaN(pa) || isNaN(st) {
        return
    }
    if readById(pa, LogicType.Activate) != 0 {
        if db.stack[INST + i] == 0 {
            // 首次触发：装栈程序并启动，记录本轮基线
            install(pa)
            db.stack[base] = readById(pa, LogicType.ExportCount)
            db.stack[INST + i] = 1
        } else if readById(pa, LogicType.ExportCount) - db.stack[base] >= readById(st, LogicType.Setting) {
            // 到量：清栈 + 停机
            clearStack(pa)
            writeById(pa, LogicType.Activate, 0)
            db.stack[INST + i] = 0
        }
    } else if db.stack[INST + i] != 0 {
        // 用户中途松手：清栈
        clearStack(pa)
        db.stack[INST + i] = 0
    }
    // 缺料：槽 54 = 第一个 MissingRecipeReagent（OP | 数量<<8 | 反应物 hash<<16）
    miss := get(pa, PrinterStack.MissingRecipeReagent)
    if miss != 0 {
        put(pa, 3, printer.ejectReagent(miss >> 16))
    }
}

// slowStep：空闲后的堆垛机排料 + 基线刷新 + On 镜像（每 tick 只处理 1 台）。
func slowStep(i num) {
    base := i * ST
    pa := db.stack[base + 2]
    st := db.stack[base + 3]
    if isNaN(pa) || isNaN(st) {
        return
    }
    if readById(pa, LogicType.Activate) != 0 {
        return // 打印中交给 fastStep
    }
    done := readById(pa, LogicType.ExportCount) - db.stack[base]
    // Setting 超过物品堆叠上限时，只吐满的，零头用 Activate 顶出来
    maxq := readByIdSlot(st, 2, MaxQuantity)
    setting := readById(st, LogicType.Setting)
    if done >= setting && maxq > 0 && setting > maxq {
        db.stack[base + 1] = 1
    }
    // 内部槽里是锭：直接排出（锭不该被留着/切）
    if readByIdSlot(st, 2, Class) == SlotClass.Ingot {
        db.stack[base + 1] = 1
    }
    db.stack[base] += done
    writeById(st, LogicType.On, readById(pa, LogicType.On))
    // 正在吐：堆垛机内部槽空了就停
    if db.stack[base + 1] != 0 && readByIdSlot(st, 2, Occupied) == 0 {
        db.stack[base + 1] = 0
    }
    if db.stack[base + 1] != 0 {
        writeById(st, LogicType.Mode, 1)
    } else {
        writeById(st, LogicType.Mode, 0)
    }
    writeById(st, LogicType.Activate, db.stack[base + 1])
}

// install：把打印任务写进打印机栈并启动。
func install(pa num) {
    put(pa, 0, printer.waitUntilNextValid())
    put(pa, 1, printer.executeRecipe(QTY, readById(pa, LogicType.RecipeHash)))
    put(pa, PrinterStack.StackPointer, printer.stackPointer(0))
}

// clearStack：清掉栈程序（no-op），让打印机空转不打印。
func clearStack(pa num) {
    put(pa, 0, printer.none())
    put(pa, 1, printer.none())
    put(pa, 2, printer.none())
    put(pa, 3, printer.none())
    put(pa, PrinterStack.StackPointer, printer.stackPointer(0))
}
