// 打印机产量控制器（打印机栈版 · 用户触发）。
//
// 与原字段版行为一致：用户触发打印机（把它的 Activate 拉起来）后才打印，
// 到量由 IC 停；空闲时刷新基线、把 On 镜像给堆垛机。
//
// 打印由打印机自己的「栈程序」执行，IC 负责装载/清除：
//   触发（Activate!=0）首次：写入栈程序并从槽 0 启动
//     槽 0  : printer.waitUntilNextValid()   缺料就等
//     槽 1  : printer.executeRecipe(QTY, 打印机当前配方)
//     槽 63 : printer.stackPointer(0)
//   到量（ExportCount 增量 >= 堆垛机 Setting）或触发结束：清栈（写成 no-op）并 Activate=0
//   —— 打印机空闲会循环遍历栈，装了不撤就会一直重打，所以必须清。
//
// 栈布局（打印机栈 64 槽）：0..53 指令，54..62 缺失反应物，63 StackPointer。
// 指令位段见 printer.* 构建器（低 8 位 OP + 参数）。
//
// 匹配：打印机按 PrefabHash（每型一台），堆垛机按名字；加一组往两张表各加一行。
// 部署：先跑一次 loader（<file>.data.ic），再烧 runtime。

const Stacker = hash("StructureStackerReverse")
const QTY = 50  // 每轮打印数量

data Printers = [
    hash("StructureAutolathe"),
    hash("StructureElectronicsPrinter"),
    hash("StructureHydraulicPipeBender"),
    hash("StructureRocketManufactory"),
    hash("StructureToolManufactory"),
    hash("StructureSecurityPrinter"),
]

data Stackers = [
    hash("Autolathe Stacker"),
    hash("Electronics Stacker"),
    hash("Pipe Stacker"),
    hash("Rocket Stacker"),
    hash("Tool Stacker"),
    hash("Security Stacker"),
]

const COUNT = len(Printers)

func main() {
    for {
        yield()
        for i, printer := range Printers {
            pa := batch.read(printer, "ReferenceId", "Average")
            st := batch.readName(Stacker, Stackers[i], "ReferenceId", "Average")
            if isNaN(pa) || isNaN(st) {
                continue
            }
            base := i * 2  // [触发基线, 已装载标志]
            if readById(pa, LogicType.Activate) != 0 {
                // 用户触发中
                if db.stack[base + 1] == 0 {
                    // 首次：写栈程序并启动，记录本轮基线
                    install(pa)
                    db.stack[base] = readById(pa, LogicType.ExportCount)
                    db.stack[base + 1] = 1
                } else if readById(pa, LogicType.ExportCount) - db.stack[base] >= readById(st, LogicType.Setting) {
                    // 到量：清栈 + 停机
                    clearStack(pa)
                    writeById(pa, LogicType.Activate, 0)
                    db.stack[base + 1] = 0
                }
            } else {
                // 空闲：兜底清栈，刷新基线，镜像 On
                if db.stack[base + 1] != 0 {
                    clearStack(pa)
                    db.stack[base + 1] = 0
                }
                db.stack[base] = readById(pa, LogicType.ExportCount)
                writeById(st, LogicType.On, readById(pa, LogicType.On))
            }
            // 缺料：把缺失的反应物从打印机排出（槽 54 = OP | 数量<<8 | 反应物 hash<<16）
            miss := get(pa, PrinterStack.MissingRecipeReagent)
            if miss != 0 {
                put(pa, 3, printer.ejectReagent(miss >> 16))
            }
        }
    }
}

// install：把打印任务写进打印机栈并启动。
func install(pa num) {
    put(pa, 0, printer.waitUntilNextValid())
    put(pa, 1, printer.executeRecipe(QTY, readById(pa, LogicType.RecipeHash)))
    put(pa, PrinterStack.StackPointer, printer.stackPointer(0))
}

// clearStack：清掉栈程序（no-op），让打印机空转不打印。
func clearStack(pa num) {
    put(pa, 0, printer.none())
    put(pa, 1, printer.none())
    put(pa, 2, printer.none())
    put(pa, 3, printer.none())
    put(pa, PrinterStack.StackPointer, printer.stackPointer(0))
}
