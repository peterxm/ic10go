// HASH 控制台（Episode 6）— 使用持久栈数据段。
// 表用 `data` 声明；编译器把它放进栈顶，runtime 用 get(db, base+i) 读取。
// loader 由 `ic10c build --split-data` 生成，运行一次即可。

const (
    dial   = 554524804
    button = 491845673
    lever  = 1220484876
    vent   = -1129453144
)

data RecipeDisplay = [
    -1301215609, -404336834, 226410516, -290196476, -929742000,
    2134647745, -1406385572, -654790771, -297990285, -82508479,
    502280180, 1058547521, 156348098, -787796599, 412924554,
    1579842814, -1897868623,
]

data RecipeHeat = [
    0.00950100000010010000, 0.00950100000100010000, 0.00950100000100010000,
    0.00950100000100010000, 0.00950100000100010000, 0.00950100000100010000,
    0.00950100000100010000, 0.00900100000100010000, 0.01200015001800020000,
    0.00350005500100010000, 0.00600100000080002350, 0.01000100002000055000,
    0.00400008005000055000, 0.00600100002350023800, 0.01000100003000040000,
    0.00950010002500030000, 0.01800100001000019500,
]

func main() {
    batch.writeName(dial, hash("Ingot Dial"), "Mode", 17)
    batch.writeName(dial, hash("Amount Dial"), "Mode", 30)
    batch.write(435685051, "On", 1)

    heat := 0
    for {
        if batch.readName(lever, hash("VentLever"), "Open", "Minimum") == 0 {
            ventOn()
        } else {
            ventOff()
        }
        mixer()

        ore := batch.readName(dial, hash("Ingot Dial"), "Setting", "Minimum")
        confirm := batch.readName(button, hash("Confirm Button"), "Setting", "Minimum")
        amount := batch.readName(dial, hash("Amount Dial"), "Setting", "Minimum")
        yield()

        if batch.readName(2037291645, hash("Silos CD"), "Setting", "Minimum") < 0 {
            db.Setting = 0
            continue
        }
        if amount == 0 {
            batch.writeName(dial, hash("Amount Dial"), "Setting", 1)
            amount = 1
        }
        if ore > 17 {
            batch.writeName(dial, hash("Ingot Dial"), "Setting", 17)
            ore = 17
        }

        qty := amount
        if ore <= 7 { qty *= 50 }
        if ore == 8 { qty *= 200 }
        if ore >= 13 {
            qty *= 50
        } else if ore >= 9 {
            qty *= 100
        }

        if ore <= 0 {
            db.Setting = 0
            continue
        }
        if confirm == 1 {
            set(heat)
        }
        batch.writeName(-815193061, hash("Amount"), "Setting", qty)

        db.Setting = RecipeDisplay[ore-1]
        heat = RecipeHeat[ore-1]
    }
}

func set(heat num) {
    yield()
    batch.writeName(2037291645, hash("Furnace IC"), "Setting", heat)
}

func ventOn() {
    batch.writeName(vent, hash("Vent 1"), "Mode", 0)
    batch.writeName(vent, hash("Vent 1"), "PressureExternal", 101)
    batch.writeName(vent, hash("Vent 1"), "PressureInternal", 0)
    batch.writeName(vent, hash("Vent 2"), "Mode", 1)
    batch.writeName(vent, hash("Vent 2"), "PressureExternal", 101)
    batch.writeName(vent, hash("Vent 2"), "PressureInternal", 55000)
    batch.writeName(vent, hash("Vent 1"), "On", 1)
    batch.writeName(vent, hash("Vent 2"), "On", 1)
}

func ventOff() {
    batch.writeName(vent, hash("Vent 1"), "PressureExternal", 0)
    batch.writeName(vent, hash("Vent 2"), "PressureExternal", 0)
}

func mixer() {
    o2 := batch.readName(435685051, hash("O2 Analyzer"), "Temperature", "Maximum")
    h2 := batch.readName(435685051, hash("H2 Analyzer"), "Temperature", "Maximum")
    batch.writeName(2104106366, hash("Fuel Mixer"), "Setting", 100/(o2/(h2*2)+1))
}
