// Barsiel HASH 数据段装载器（原型）。
// 运行一次，把矿石 -> (显示哈希, 比热) 表写入 IC 宿主栈；之后换成本 runtime
// 代码，数据仍在栈中。槽位约定：
//   0..16  : 显示哈希
//   17..33 : 比热
//   34     : 版本哨兵
func main() {
    put(db, 0, -1301215609)   // Iron
    put(db, 1, -404336834)    // Copper
    put(db, 2, 226410516)     // Gold
    put(db, 3, -290196476)    // Silicon
    put(db, 4, -929742000)    // Silver
    put(db, 5, 2134647745)    // Lead
    put(db, 6, -1406385572)   // Nickel
    put(db, 7, -654790771)    // Steel
    put(db, 8, -297990285)    // Invar
    put(db, 9, -82508479)     // Solder
    put(db, 10, 502280180)    // Electrum
    put(db, 11, 1058547521)   // Constantan
    put(db, 12, 156348098)    // Waspaloy
    put(db, 13, -787796599)   // Inconel
    put(db, 14, 412924554)    // Astroloy
    put(db, 15, 1579842814)   // Hastelloy
    put(db, 16, -1897868623)  // Setllite

    put(db, 17, 0.00950100000010010000)  // Iron
    put(db, 18, 0.00950100000100010000)  // Copper
    put(db, 19, 0.00950100000100010000)  // Gold
    put(db, 20, 0.00950100000100010000)  // Silicon
    put(db, 21, 0.00950100000100010000)  // Silver
    put(db, 22, 0.00950100000100010000)  // Lead
    put(db, 23, 0.00950100000100010000)  // Nickel
    put(db, 24, 0.00900100000100010000)  // Steel
    put(db, 25, 0.01200015001800020000)  // Invar
    put(db, 26, 0.00350005500100010000)  // Solder
    put(db, 27, 0.00600100000080002350)  // Electrum
    put(db, 28, 0.01000100002000055000)  // Constantan
    put(db, 29, 0.00400008005000055000)  // Waspaloy
    put(db, 30, 0.00600100002350023800)  // Inconel
    put(db, 31, 0.01000100003000040000)  // Astroloy
    put(db, 32, 0.00950010002500030000)  // Hastelloy
    put(db, 33, 0.01800100001000019500)  // Setllite

    put(db, 34, 1)  // 版本哨兵
}
